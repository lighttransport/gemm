diff --git a/examples/lightphysics_vhuman_face/full.h b/examples/lightphysics_vhuman_face/full.h
new file mode 100644
index 0000000..07be36f
--- /dev/null
+++ b/examples/lightphysics_vhuman_face/full.h
@@ -0,0 +1,68 @@
+/* Head-local, reduced-coordinate mandible driver for the full facial example. */
+#ifndef LIGHTPHYSICS_VHUMAN_FULL_H_
+#define LIGHTPHYSICS_VHUMAN_FULL_H_
+#include <stdint.h>
+#include "lightphysics_deformable.h"
+#include "lightphysics_surface_contact.h"
+typedef struct vhface_jaw_muscle {
+    int32_t muscle;
+    double origin[3], insertion[3];
+    double max_force, optimal_length;
+} vhface_jaw_muscle_t;
+uint32_t vhface_full_abi(void);
+int vhface_jaw_transform(const double *rest, int32_t count, const double hinge[3],
+                         const double q[3], double *out);
+/* Opening-dependent translation in metres/radian, fitted to a subject rig. */
+int vhface_jaw_transform_model(const double *rest,int32_t count,const double hinge[3],
+    const double q[3],const double track[3],double *out);
+/* q = opening angle, lateral slide, forward slide. A condylar track couples
+ * vertical translation to opening. Only forces drive q; limits are inelastic.
+ * reaction is generalized tissue/contact force, not a trajectory servo. */
+int vhface_jaw_step(double q[3], double velocity[3], const double hinge[3],
+                   const vhface_jaw_muscle_t *muscles, int32_t count,
+                   const double *activations, int32_t nmuscles,
+                   const double reaction[3], double dt);
+/* Same force integration with explicit positive inertia and nonnegative
+ * viscous resistance. Defaults remain the authored legacy values. */
+int vhface_jaw_step_configured(double q[3], double velocity[3], const double hinge[3],
+    const vhface_jaw_muscle_t *muscles,int32_t count,const double *activations,
+    int32_t nmuscles,const double reaction[3],double dt,
+    const double inertia[3],const double damping[3]);
+int vhface_jaw_step_model(double q[3],double velocity[3],const double hinge[3],
+    const vhface_jaw_muscle_t *muscles,int32_t count,const double *activations,
+    int32_t nmuscles,const double reaction[3],double dt,
+    const double inertia[3],const double damping[3],const double track[3]);
+typedef struct vhface_jaw_coupling vhface_jaw_coupling_t;
+/* Own the body's coupling-projector slot. Anchors must be free tissue nodes;
+ * rigid indices must have zero inverse mass and no incident tetrahedra. Rest
+ * points are head-local and copied. Static attachments for these same anchors
+ * must be removed by the caller. Destroy before the body; not concurrent. */
+int vhface_jaw_coupling_create(lightphysics_deformable_t *body,const double hinge[3],
+    const int32_t *anchors,const double *anchor_rest,const double *compliance,int32_t count,
+    const int32_t *rigid,const double *rigid_rest,int32_t rigid_count,vhface_jaw_coupling_t **out);
+int vhface_jaw_coupling_create_model(lightphysics_deformable_t *body,const double hinge[3],const double track[3],
+    const int32_t *anchors,const double *anchor_rest,const double *compliance,int32_t count,
+    const int32_t *rigid,const double *rigid_rest,int32_t rigid_count,vhface_jaw_coupling_t **out);
+void vhface_jaw_coupling_destroy(vhface_jaw_coupling_t *coupling);
+/* Set force-predicted coordinates and effective inverse inertia for one body
+ * step (one substep). Dynamic multipliers reset with the body's projector.
+ * Read q only after the body step; an error/cancel requires caller rollback. */
+int vhface_jaw_coupling_prepare(vhface_jaw_coupling_t *coupling,
+    const double q[3],const double inverse_inertia[3],double dt);
+int vhface_jaw_coupling_read(const vhface_jaw_coupling_t *coupling,double q[3]);
+/* Opt-in local volume/reduced-coordinate solve after a clipped attachment.
+ * Static configuration across snapshots; set only between body steps. */
+int vhface_jaw_coupling_enable_volume_solve(vhface_jaw_coupling_t *coupling,int enabled);
+/* Opt-in simultaneous attachment projection using a three-coordinate Schur
+ * complement. All tissue/jaw/multiplier changes share one exact volume-safe
+ * fraction. Replaces the sequential attachment loop; static configuration. */
+int vhface_jaw_coupling_enable_block_solve(vhface_jaw_coupling_t *coupling,int enabled);
+/* Project an embedded boundary with the prepared jaw's effective mobility.
+ * Dental contacts update the same reduced coordinates and rigid particles;
+ * callers must not also feed these impulses back into the next prediction. */
+int vhface_jaw_contact_project(vhface_jaw_coupling_t *coupling,
+    lightphysics_surface_contact_t *contact,const int32_t *embedding_indices,
+    const double *embedding_weights,const double *previous,double *x,
+    double dt,double thickness,int32_t iterations,double *reaction,
+    lightphysics_surface_contact_stats_t *stats,double *minimum_fraction);
+#endif
diff --git a/include/lightphysics_active_tissue.h b/include/lightphysics_active_tissue.h
new file mode 100644
index 0000000..bf7be1a
--- /dev/null
+++ b/include/lightphysics_active_tissue.h
@@ -0,0 +1,70 @@
+/* Distributed muscle stress on tetrahedral tissue. SPDX-License-Identifier: Apache-2.0 */
+#ifndef LIGHTPHYSICS_ACTIVE_TISSUE_H_
+#define LIGHTPHYSICS_ACTIVE_TISSUE_H_
+#include "lightphysics_deformable.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct lightphysics_active_fiber {
+    int32_t tetrahedron;
+    int32_t muscle;
+    double direction[3];        /* Unit rest-space direction (normalized on create). */
+    double peak_stress;         /* Pa, including the fraction of occupied tissue. */
+} lightphysics_active_fiber_t;
+typedef struct lightphysics_active_tissue lightphysics_active_tissue_t;
+#define LIGHTPHYSICS_ACTIVE_CABLE_MAX_VERTICES 16
+/* An external muscle segment from a fixed head-local origin to a distributed
+ * insertion in free tissue. Weights are nonnegative and sum to one. The
+ * external support takes the paired reaction; rigid jaw insertions require a
+ * reduced-coordinate bridge and are deliberately not accepted here. */
+typedef struct lightphysics_active_cable {
+    int32_t muscle,vertex_count;
+    int32_t vertices[LIGHTPHYSICS_ACTIVE_CABLE_MAX_VERTICES];
+    double weights[LIGHTPHYSICS_ACTIVE_CABLE_MAX_VERTICES];
+    double origin[3];
+    double max_force,rest_length,shortening;
+} lightphysics_active_cable_t;
+
+/* A field borrows its body; rest/tets/fields are copied. Activations are
+ * supplied by the caller, so snapshots of the body plus caller-owned muscle
+ * activation states form a complete replay state. The reference rest buffer
+ * must cover the body; every referenced tetrahedral vertex must belong to the
+ * body. A reference tetrahedral subset/overlay is allowed. */
+lightphysics_status_t lightphysics_active_tissue_create(
+    lightphysics_deformable_t *body, const float *rest, int32_t nverts,
+    const int32_t *tets, int32_t ntets,
+    const lightphysics_active_fiber_t *fields, int32_t nfields,
+    int32_t nmuscles, lightphysics_active_tissue_t **out);
+void lightphysics_active_tissue_destroy(lightphysics_active_tissue_t *field);
+/* Replace copied external segments between steps, without changing body or
+ * activation state. Invalid input/allocation failure is atomic. Vertex lists
+ * must be unique, free tissue nodes; 1..16 per segment. Weights within 1e-8 of
+ * unit sum are normalized on copy. Positive rest_length and 0<shortening<1
+ * define the unloaded length; max_force is nonnegative. Zero count removes
+ * all segments. This static configuration must match when replaying snapshots. */
+lightphysics_status_t lightphysics_active_tissue_set_cables(
+    lightphysics_active_tissue_t *field,const lightphysics_active_cable_t *cables,int32_t count);
+/* Paired fixed-origin impulses from the last apply/step, three doubles per
+ * segment. Diagnostic, not physical snapshot state; zero segments allow NULL. */
+lightphysics_status_t lightphysics_active_tissue_read_cable_reactions(
+    const lightphysics_active_tissue_t *field,double *out,size_t double_count);
+/* Opt in to activation-driven, tension-only XPBD fibers inside the passive
+ * solve. Peak isometric stress is matched at unit stretch, with a Gaussian
+ * length-tension envelope and authored 15% unloaded shortening. apply then
+ * supplies activations rather than explicit impulses. The field must be
+ * destroyed before its borrowed body; one projector can own each body. */
+lightphysics_status_t lightphysics_active_tissue_enable_implicit(
+    lightphysics_active_tissue_t *field, int enabled);
+/* Sum self-equilibrated nodal impulses from active Piola fiber stress.
+ * Gaussian length-tension envelope, passive tissue supplied by the body.
+ * No rest lengths or skinned target positions are modified. In implicit mode
+ * this copies activations for the next substep projector instead of applying
+ * impulses; callers resupply activations after restoring a body snapshot. */
+lightphysics_status_t lightphysics_active_tissue_apply(
+    lightphysics_active_tissue_t *field, const double *activations,
+    int32_t count, double dt);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/include/lightphysics_surface_contact.h b/include/lightphysics_surface_contact.h
new file mode 100644
index 0000000..35f1d80
--- /dev/null
+++ b/include/lightphysics_surface_contact.h
@@ -0,0 +1,91 @@
+/* CPU swept surface contact, independent of the volume integrator. */
+#ifndef LIGHTPHYSICS_SURFACE_CONTACT_H_
+#define LIGHTPHYSICS_SURFACE_CONTACT_H_
+#include "lightphysics.h"
+#include "lightphysics_deformable.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+typedef struct lightphysics_surface_contact lightphysics_surface_contact_t;
+typedef struct lightphysics_surface_contact_stats {
+    uint64_t candidates, contacts;
+    double max_correction;
+} lightphysics_surface_contact_stats_t;
+/* Caller-owned reduced-coordinate bridge, used only during one projection.
+ * read maps nodal gap gradients to three generalized gradients and returns
+ * effective inverse inertia/current coordinates/bounds without mutation.
+ * apply commits delta_q, updates the body and the supplied volume cache, and
+ * returns its additional changed node list (valid until the next callback).
+ * Only zero-mass particles with no incident tetrahedra may be moved by apply;
+ * use write_kinematic_positions_indexed_f64 to preserve tissue dynamics.
+ * Callbacks run serially and must not recurse into this contact object. */
+typedef struct lightphysics_surface_reduced_motion {
+    void *context;
+    lightphysics_status_t (*read)(void *context,const int32_t *vertices,const double *gradients,int32_t count,
+        double generalized_gradient[3],double inverse_inertia[3],double q[3],double lower[3],double upper[3]);
+    lightphysics_status_t (*apply)(void *context,const double delta_q[3],double *volume_cache,
+        const int32_t **changed_vertices,int32_t *changed_count);
+} lightphysics_surface_reduced_motion_t;
+/* Copies topology and inverse masses. Zero inverse mass marks a rigid/pinned
+ * vertex; the equal-and-opposite constraint impulse is accumulated in reaction.
+ * Input faces must be a nondegenerate triangular boundary. */
+lightphysics_status_t lightphysics_surface_contact_create(
+    const double *rest, const double *inverse_mass, int32_t nverts,
+    const int32_t *faces, int32_t nfaces, lightphysics_surface_contact_t **out);
+void lightphysics_surface_contact_destroy(lightphysics_surface_contact_t *contact);
+/* Refit swept BVHs, use conservative advancement for VF and EE trajectories,
+ * then distribute unilateral corrections by barycentric inverse mass.
+ * x is updated in place; reaction is 3*nverts N s (may be NULL). */
+lightphysics_status_t lightphysics_surface_contact_project(
+    lightphysics_surface_contact_t *contact, const double *previous,
+    double *x, double dt, double thickness, int32_t iterations,
+    double *reaction, lightphysics_surface_contact_stats_t *stats);
+/* Project contacts on a tetrahedrally embedded boundary directly onto its
+ * volume nodes. Each surface vertex has four indices/weights, with sum within
+ * 1e-8 of one and summed absolute weight at most 3. Shared-node
+ * gradients are combined before computing effective inverse mass; one signed
+ * volume-safe fraction scales each constraint and its paired reaction.
+ * x must agree with the body's current embedding (within 1e-10 metres).
+ * Valid calls update body positions and x; cancellation/solver failure can
+ * leave a partial projection, so callers needing rollback must own a snapshot.
+ * Invalid arguments/correspondence and allocation failure do not change the
+ * body or x. This call must not overlap any other use of contact or body. */
+lightphysics_status_t lightphysics_surface_contact_project_embedded(
+    lightphysics_surface_contact_t *contact, lightphysics_deformable_t *body,
+    const int32_t *embedding_indices, const double *embedding_weights,
+    const double *previous, double *x, double dt, double thickness,
+    int32_t iterations, double *reaction,
+    lightphysics_surface_contact_stats_t *stats, double *minimum_fraction);
+/* Experimental local mass projection with incident volume constraints. Same
+ * correspondence, ownership and rollback contract as project_embedded. */
+lightphysics_status_t lightphysics_surface_contact_project_embedded_volume(
+    lightphysics_surface_contact_t *contact, lightphysics_deformable_t *body,
+    const int32_t *embedding_indices, const double *embedding_weights,
+    const double *previous, double *x, double dt, double thickness,
+    int32_t iterations, double *reaction,
+    lightphysics_surface_contact_stats_t *stats, double *minimum_fraction);
+/* Dense local active-set contact solve with optional reduced-coordinate
+ * motion. NULL motion retains fixed rigid particles. The ownership, cache
+ * correspondence and rollback contracts of project_embedded still apply. */
+lightphysics_status_t lightphysics_surface_contact_project_embedded_reduced(
+    lightphysics_surface_contact_t *contact,lightphysics_deformable_t *body,
+    const int32_t *embedding_indices,const double *embedding_weights,
+    const double *previous,double *x,double dt,double thickness,int32_t iterations,
+    double *reaction,lightphysics_surface_contact_stats_t *stats,double *minimum_fraction,
+    const lightphysics_surface_reduced_motion_t *motion);
+/* Independent final-geometry check: count proper edge/triangle crossings.
+ * Shared topological neighborhoods and mere touching are excluded. */
+lightphysics_status_t lightphysics_surface_contact_count_intersections(
+    lightphysics_surface_contact_t *contact, const double *positions,
+    uint64_t *out_count);
+/* Enumerate the same proper crossings. Each record is five vertex indices:
+ * edge endpoints followed by the triangle. Writes at most capacity records;
+ * out_count always receives the full count. NULL records requires capacity=0.
+ * This read-only geometry query does not modify positions or solver state. */
+lightphysics_status_t lightphysics_surface_contact_find_intersections(
+    lightphysics_surface_contact_t *contact, const double *positions,
+    int32_t *records, size_t capacity, uint64_t *out_count);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/src/lightphysics/lightphysics_active_tissue.c b/src/lightphysics/lightphysics_active_tissue.c
new file mode 100644
index 0000000..2e10763
--- /dev/null
+++ b/src/lightphysics/lightphysics_active_tissue.c
@@ -0,0 +1,332 @@
+#include "lightphysics_active_tissue.h"
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+struct lightphysics_active_tissue {
+    lightphysics_deformable_t *body;
+    int32_t nverts, nfields, nmuscles;
+    lightphysics_active_fiber_t *fields;
+    int32_t *indices, *geometry;
+    unsigned char *occupied;
+    double *gradients, *volumes, *impulses;
+    float *positions;
+    double *activation, *lambda;
+    int32_t ncables;
+    lightphysics_active_cable_t *cables;
+    double *cable_lambda,*cable_reactions;
+    int implicit;
+};
+
+static void project_implicit(void *context, double *x, const double *mass,
+                             double dt, int reset);
+
+static int has_active_fibers(const lightphysics_active_tissue_t *f) {
+    for (int32_t i=0;i<f->nmuscles;++i)
+        if (f->occupied[i] && f->activation[i]>0) return 1;
+    for (int32_t i=0;i<f->ncables;++i)
+        if (f->cables[i].max_force>0 && f->activation[f->cables[i].muscle]>0) return 1;
+    return 0;
+}
+
+void lightphysics_active_tissue_destroy(lightphysics_active_tissue_t *f) {
+    if (!f) return;
+    if (f->implicit) {
+        lightphysics_deformable_set_projector(f->body, NULL, NULL);
+        lightphysics_deformable_enable_guarded_solve(f->body,0);
+    }
+    free(f->activation); free(f->lambda);
+    free(f->cables);free(f->cable_lambda);free(f->cable_reactions);
+    free(f->fields); free(f->indices); free(f->geometry); free(f->occupied);
+    free(f->gradients); free(f->volumes);
+    free(f->impulses); free(f->positions); free(f);
+}
+
+lightphysics_status_t lightphysics_active_tissue_create(
+    lightphysics_deformable_t *body, const float *rest, int32_t nv,
+    const int32_t *tets, int32_t nt,
+    const lightphysics_active_fiber_t *fields, int32_t nf, int32_t nm,
+    lightphysics_active_tissue_t **out) {
+    if (!out) return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    *out = NULL;
+    const int32_t body_vertices=body ? lightphysics_deformable_num_vertices(body) : 0;
+    if (!body || !rest || !tets || nv < 4 || nt < 1 || nf < 0 || nm < 1 ||
+        (nf && !fields) || nv<body_vertices) return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    for (size_t i = 0; i < (size_t)nv * 3; ++i)
+        if (!isfinite(rest[i])) return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    lightphysics_active_tissue_t *f = calloc(1, sizeof *f);
+    if (!f) return LIGHTPHYSICS_E_OUT_OF_MEMORY;
+    f->body = body; f->nverts = body_vertices; f->nfields = nf; f->nmuscles = nm;
+    f->fields = calloc((size_t)nf + 1, sizeof *f->fields);
+    f->geometry = malloc((size_t)nt * sizeof *f->geometry);
+    f->occupied = calloc((size_t)nm, sizeof *f->occupied);
+    f->impulses = calloc((size_t)body_vertices * 3, sizeof *f->impulses);
+    f->positions = calloc((size_t)body_vertices * 3, sizeof *f->positions);
+    f->activation = calloc((size_t)nm, sizeof(double));
+    f->lambda = calloc((size_t)nf + 1, sizeof(double));
+    if (!f->fields || !f->geometry || !f->occupied ||
+        !f->impulses || !f->positions || !f->activation || !f->lambda) {
+        lightphysics_active_tissue_destroy(f); return LIGHTPHYSICS_E_OUT_OF_MEMORY;
+    }
+    if (lightphysics_deformable_read_positions(body, f->positions, (size_t)body_vertices * 3) != LIGHTPHYSICS_OK)
+        goto invalid;
+    for (int32_t t=0;t<nt;++t) f->geometry[t]=-1;
+    int32_t geometry_count=0;
+    for (int32_t k = 0; k < nf; ++k) {
+        f->fields[k] = fields[k];
+        lightphysics_active_fiber_t *a = &f->fields[k];
+        if (a->tetrahedron < 0 || a->tetrahedron >= nt || a->muscle < 0 ||
+            a->muscle >= nm || !isfinite(a->peak_stress) || a->peak_stress < 0)
+            goto invalid;
+        double length = 0;
+        for (int j = 0; j < 3; ++j) {
+            if (!isfinite(a->direction[j])) goto invalid;
+            length += a->direction[j] * a->direction[j];
+        }
+        length = sqrt(length);
+        if (length < 1e-12) goto invalid;
+        for (int j = 0; j < 3; ++j) a->direction[j] /= length;
+        if (a->peak_stress>0) f->occupied[a->muscle]=1;
+        if (f->geometry[a->tetrahedron]<0) f->geometry[a->tetrahedron]=geometry_count++;
+    }
+    /* Rest geometry depends on the tetrahedron, not on the number of muscle
+     * families crossing it. Keep one exact copy per referenced tetrahedron. */
+    f->indices=calloc((size_t)geometry_count*4+1,sizeof *f->indices);
+    f->gradients=calloc((size_t)geometry_count*12+1,sizeof *f->gradients);
+    f->volumes=calloc((size_t)geometry_count+1,sizeof *f->volumes);
+    if (!f->indices || !f->gradients || !f->volumes) {
+        lightphysics_active_tissue_destroy(f); return LIGHTPHYSICS_E_OUT_OF_MEMORY;
+    }
+    for (int32_t k=0;k<nf;++k) {
+        const lightphysics_active_fiber_t *a=f->fields+k;
+        const int32_t geometry=f->geometry[a->tetrahedron];
+        if (f->volumes[geometry]>0) continue;
+        int32_t *id = f->indices + 4 * geometry;
+        for (int j = 0; j < 4; ++j) {
+            id[j] = tets[4 * a->tetrahedron + j];
+            if (id[j] < 0 || id[j] >= body_vertices) goto invalid;
+        }
+        double d[9], inv[9];
+        for (int r = 0; r < 3; ++r) for (int c = 0; c < 3; ++c)
+            d[3*r+c] = rest[3*id[c+1]+r] - rest[3*id[0]+r];
+        double det = d[0]*(d[4]*d[8]-d[5]*d[7]) - d[1]*(d[3]*d[8]-d[5]*d[6]) + d[2]*(d[3]*d[7]-d[4]*d[6]);
+        if (!isfinite(det) || fabs(det) < 1e-18) goto invalid;
+        inv[0]=(d[4]*d[8]-d[5]*d[7])/det; inv[1]=(d[2]*d[7]-d[1]*d[8])/det;
+        inv[2]=(d[1]*d[5]-d[2]*d[4])/det; inv[3]=(d[5]*d[6]-d[3]*d[8])/det;
+        inv[4]=(d[0]*d[8]-d[2]*d[6])/det; inv[5]=(d[2]*d[3]-d[0]*d[5])/det;
+        inv[6]=(d[3]*d[7]-d[4]*d[6])/det; inv[7]=(d[1]*d[6]-d[0]*d[7])/det;
+        inv[8]=(d[0]*d[4]-d[1]*d[3])/det;
+        double *g = f->gradients + 12*geometry;
+        for (int j=0;j<3;++j) for (int c=0;c<3;++c) {
+            g[3*(j+1)+c]=inv[3*j+c]; g[c]-=inv[3*j+c];
+        }
+        f->volumes[geometry]=fabs(det)/6.;
+    }
+    *out=f; return LIGHTPHYSICS_OK;
+invalid:
+    lightphysics_active_tissue_destroy(f); return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+}
+
+lightphysics_status_t lightphysics_active_tissue_set_cables(
+    lightphysics_active_tissue_t *f,const lightphysics_active_cable_t *cables,int32_t count) {
+    if (!f || count<0 || (count && !cables) ||
+        (size_t)count>SIZE_MAX/sizeof(lightphysics_active_cable_t) ||
+        (size_t)count>SIZE_MAX/sizeof(double)/3) return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    float *mass=count ? malloc((size_t)f->nverts*sizeof(float)) : NULL;
+    if (count && !mass) return LIGHTPHYSICS_E_OUT_OF_MEMORY;
+    if (count && lightphysics_deformable_read_inverse_masses(f->body,mass,f->nverts)!=LIGHTPHYSICS_OK) {
+        free(mass);return LIGHTPHYSICS_E_INVALID_STATE;
+    }
+    for (int32_t i=0;i<count;++i) {
+        const lightphysics_active_cable_t *c=cables+i;
+        if (c->muscle<0 || c->muscle>=f->nmuscles || c->vertex_count<1 ||
+            c->vertex_count>LIGHTPHYSICS_ACTIVE_CABLE_MAX_VERTICES ||
+            !isfinite(c->max_force) || c->max_force<0 || !isfinite(c->rest_length) || c->rest_length<=0 ||
+            !isfinite(c->shortening) || c->shortening<=0 || c->shortening>=1 ||
+            !(c->shortening*c->rest_length>0) || !isfinite(c->shortening*c->rest_length) ||
+            !isfinite(c->max_force/(c->shortening*c->rest_length))) goto invalid_cables;
+        for (int k=0;k<3;++k) if (!isfinite(c->origin[k])) goto invalid_cables;
+        double sum=0;
+        for (int j=0;j<c->vertex_count;++j) {
+            const int32_t vertex=c->vertices[j];
+            if (vertex<0 || vertex>=f->nverts || !isfinite(c->weights[j]) || c->weights[j]<0 ||
+                !(mass[vertex]>0)) goto invalid_cables;
+            for (int k=0;k<j;++k) if (vertex==c->vertices[k]) goto invalid_cables;
+            sum+=c->weights[j];
+        }
+        if (!isfinite(sum) || fabs(sum-1)>1e-8) goto invalid_cables;
+    }
+    free(mass);mass=NULL;
+    lightphysics_active_cable_t *copy=count ? malloc((size_t)count*sizeof *copy) : NULL;
+    double *multipliers=count ? calloc((size_t)count,sizeof(double)) : NULL;
+    double *reactions=count ? calloc((size_t)count*3,sizeof(double)) : NULL;
+    if (count && (!copy || !multipliers || !reactions)) {
+        free(copy);free(multipliers);free(reactions);return LIGHTPHYSICS_E_OUT_OF_MEMORY;
+    }
+    for (int32_t i=0;i<count;++i) {
+        copy[i]=cables[i];double sum=0;
+        for (int j=0;j<copy[i].vertex_count;++j) sum+=copy[i].weights[j];
+        for (int j=0;j<copy[i].vertex_count;++j) copy[i].weights[j]/=sum;
+    }
+    if (f->implicit) {
+        int active=0;
+        for (int32_t i=0;i<f->nmuscles;++i) if (f->occupied[i] && f->activation[i]>0) active=1;
+        for (int32_t i=0;i<count;++i) if (copy[i].max_force>0 && f->activation[copy[i].muscle]>0) active=1;
+        lightphysics_status_t status=lightphysics_deformable_set_projector(f->body,active ? project_implicit : NULL,active ? f : NULL);
+        if (status!=LIGHTPHYSICS_OK) {free(copy);free(multipliers);free(reactions);return status;}
+    }
+    free(f->cables);free(f->cable_lambda);free(f->cable_reactions);
+    f->cables=copy;f->cable_lambda=multipliers;f->cable_reactions=reactions;f->ncables=count;
+    return LIGHTPHYSICS_OK;
+invalid_cables:
+    free(mass);return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+}
+
+lightphysics_status_t lightphysics_active_tissue_read_cable_reactions(
+    const lightphysics_active_tissue_t *f,double *out,size_t count) {
+    if (!f || count<(size_t)f->ncables*3 || (f->ncables && !out)) return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    if (f->ncables) memcpy(out,f->cable_reactions,(size_t)f->ncables*3*sizeof(double));
+    return LIGHTPHYSICS_OK;
+}
+
+lightphysics_status_t lightphysics_active_tissue_apply(
+    lightphysics_active_tissue_t *f, const double *a, int32_t count, double dt) {
+    if (!f || !a || count != f->nmuscles || !isfinite(dt) || dt <= 0)
+        return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    for (int i=0;i<count;++i)
+        if (!isfinite(a[i]) || a[i]<0 || a[i]>1) return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    if (f->ncables) memset(f->cable_reactions,0,(size_t)f->ncables*3*sizeof(double));
+    if (f->implicit) {
+        memcpy(f->activation,a,(size_t)count*sizeof(double));
+        /* Leave guarded passive tissue enabled when the muscle projector is
+         * idle. A subsequent nonzero apply reinstalls it before integration. */
+        const int active=has_active_fibers(f);
+        return lightphysics_deformable_set_projector(f->body,active ? project_implicit : NULL,active ? f : NULL);
+    }
+    lightphysics_status_t status=lightphysics_deformable_read_positions(f->body,f->positions,(size_t)f->nverts*3);
+    if (status!=LIGHTPHYSICS_OK) return status;
+    memset(f->impulses,0,(size_t)f->nverts*3*sizeof(double));
+    for (int k=0;k<f->nfields;++k) {
+        const lightphysics_active_fiber_t *fiber=&f->fields[k];
+        const int32_t geometry=f->geometry[fiber->tetrahedron];
+        const int32_t *id=f->indices+4*geometry;
+        const double *g=f->gradients+12*geometry;
+        double u[3]={0}, projected[4];
+        for (int j=0;j<4;++j) {
+            projected[j]=0;
+            for (int c=0;c<3;++c) projected[j]+=g[3*j+c]*fiber->direction[c];
+            for (int c=0;c<3;++c) u[c]+=f->positions[3*id[j]+c]*projected[j];
+        }
+        double stretch=sqrt(u[0]*u[0]+u[1]*u[1]+u[2]*u[2]);
+        if (stretch<1e-12) continue;
+        double z=(stretch-1.)/.5;
+        double scale=-a[fiber->muscle]*fiber->peak_stress*exp(-z*z)*f->volumes[geometry]*dt/stretch;
+        for (int j=0;j<4;++j) for (int c=0;c<3;++c)
+            f->impulses[3*id[j]+c]+=scale*u[c]*projected[j];
+    }
+    for (int32_t i=0;i<f->ncables;++i) {
+        const lightphysics_active_cable_t *c=f->cables+i;
+        double direction[3]={-c->origin[0],-c->origin[1],-c->origin[2]};
+        for (int j=0;j<c->vertex_count;++j) for (int k=0;k<3;++k)
+            direction[k]+=c->weights[j]*f->positions[3*c->vertices[j]+k];
+        const double length=hypot(hypot(direction[0],direction[1]),direction[2]);
+        const double target=c->rest_length*(1-c->shortening);
+        if (!isfinite(length) || length<=target || length<1e-12) continue;
+        const double z=(length/c->rest_length-1)/.5;
+        const double stiffness=a[c->muscle]*c->max_force/(c->shortening*c->rest_length)*exp(-z*z);
+        const double impulse=stiffness*(length-target)*dt;
+        if (!isfinite(impulse)) return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+        for (int k=0;k<3;++k) {
+            const double value=impulse*direction[k]/length;
+            f->cable_reactions[3*i+k]=value;
+            for (int j=0;j<c->vertex_count;++j) f->impulses[3*c->vertices[j]+k]-=c->weights[j]*value;
+        }
+    }
+    return lightphysics_deformable_apply_impulses(f->body,f->impulses,(size_t)f->nverts*3);
+}
+
+static void project_implicit(void *context, double *x, const double *mass,
+                             double dt, int reset) {
+    lightphysics_active_tissue_t *f = context;
+    if (reset) {
+        memset(f->lambda, 0, (size_t)f->nfields * sizeof(double));
+        if (f->ncables) {
+            memset(f->cable_lambda,0,(size_t)f->ncables*sizeof(double));
+            memset(f->cable_reactions,0,(size_t)f->ncables*3*sizeof(double));
+        }
+        return;
+    }
+    for (int k = 0; k < f->nfields; ++k) {
+        if ((k&4095)==0 && lightphysics_deformable_cancelled(f->body)) return;
+        const lightphysics_active_fiber_t *fiber = f->fields + k;
+        const double activity = f->activation[fiber->muscle];
+        if (activity <= 0 || fiber->peak_stress <= 0) continue;
+        const int32_t geometry=f->geometry[fiber->tetrahedron];
+        const int32_t *ids = f->indices + 4*geometry;
+        const double *grad = f->gradients + 12*geometry;
+        double coefficients[4], direction[3] = {0};
+        for (int j = 0; j < 4; ++j) {
+            coefficients[j] = 0;
+            for (int c = 0; c < 3; ++c)
+                coefficients[j] += grad[3*j+c]*fiber->direction[c];
+            for (int c = 0; c < 3; ++c)
+                direction[c] += x[3*ids[j]+c]*coefficients[j];
+        }
+        double length = sqrt(direction[0]*direction[0] + direction[1]*direction[1] + direction[2]*direction[2]);
+        if (!isfinite(length) || length <= .85) continue;
+        double envelope = exp(-pow((length-1)/.5, 2));
+        double stiffness = activity*fiber->peak_stress*envelope/.15;
+        if (stiffness < 1e-12) continue;
+        double alpha = 1/(stiffness*f->volumes[geometry]*dt*dt);
+        double denominator = alpha;
+        for (int j = 0; j < 4; ++j)
+            denominator += mass[ids[j]]*coefficients[j]*coefficients[j];
+        double change = (-(length-.85)-alpha*f->lambda[k])/denominator;
+        /* Tension-only: a muscle does not push after reaching its unloaded
+         * target. Its gradient is balanced and produces no net torque. */
+        double next = fmin(0, f->lambda[k]+change);
+        change = next-f->lambda[k];
+        double displacement[12],fraction=0;
+        for (int j = 0; j < 4; ++j) for (int c = 0; c < 3; ++c)
+            displacement[3*j+c] = mass[ids[j]]*change*coefficients[j]*direction[c]/length;
+        if (lightphysics_deformable_project_guarded(f->body,ids,displacement,4,&fraction)==LIGHTPHYSICS_OK)
+            f->lambda[k] += fraction*change;
+    }
+    for (int32_t i=0;i<f->ncables;++i) {
+        if (lightphysics_deformable_cancelled(f->body)) return;
+        const lightphysics_active_cable_t *c=f->cables+i;
+        if (f->activation[c->muscle]<=0 || c->max_force<=0) continue;
+        double direction[3]={-c->origin[0],-c->origin[1],-c->origin[2]};
+        for (int j=0;j<c->vertex_count;++j) for (int k=0;k<3;++k)
+            direction[k]+=c->weights[j]*x[3*c->vertices[j]+k];
+        const double length=hypot(hypot(direction[0],direction[1]),direction[2]);
+        const double target=c->rest_length*(1-c->shortening);
+        if (!isfinite(length) || length<=target || length<1e-12) continue;
+        const double z=(length/c->rest_length-1)/.5;
+        const double stiffness=f->activation[c->muscle]*c->max_force/(c->shortening*c->rest_length)*exp(-z*z);
+        if (!(stiffness>1e-30) || !isfinite(stiffness)) continue;
+        const double alpha=1/(stiffness*dt*dt);
+        double denominator=alpha;
+        for (int j=0;j<c->vertex_count;++j) denominator+=mass[c->vertices[j]]*c->weights[j]*c->weights[j];
+        const double change=(-(length-target)-alpha*f->cable_lambda[i])/denominator;
+        const double next=fmin(0,f->cable_lambda[i]+change),increment=next-f->cable_lambda[i];
+        double displacement[LIGHTPHYSICS_ACTIVE_CABLE_MAX_VERTICES*3],fraction;
+        for (int j=0;j<c->vertex_count;++j) for (int k=0;k<3;++k)
+            displacement[3*j+k]=mass[c->vertices[j]]*increment*c->weights[j]*direction[k]/length;
+        if (lightphysics_deformable_project_guarded_batch(f->body,c->vertices,displacement,c->vertex_count,&fraction)!=LIGHTPHYSICS_OK) continue;
+        f->cable_lambda[i]+=fraction*increment;
+        for (int k=0;k<3;++k) f->cable_reactions[3*i+k]-=fraction*increment*direction[k]/length/dt;
+    }
+}
+
+lightphysics_status_t lightphysics_active_tissue_enable_implicit(
+    lightphysics_active_tissue_t *field, int enabled) {
+    if (!field) return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    lightphysics_status_t guarded=lightphysics_deformable_enable_guarded_solve(field->body,!!enabled);
+    if (guarded!=LIGHTPHYSICS_OK) return guarded;
+    const int active=enabled && has_active_fibers(field);
+    lightphysics_status_t status = lightphysics_deformable_set_projector(
+        field->body, active ? project_implicit : NULL, active ? field : NULL);
+    if (status == LIGHTPHYSICS_OK) field->implicit = !!enabled;
+    return status;
+}
diff --git a/src/lightphysics/lightphysics_surface_contact.c b/src/lightphysics/lightphysics_surface_contact.c
new file mode 100644
index 0000000..0a27a57
--- /dev/null
+++ b/src/lightphysics/lightphysics_surface_contact.c
@@ -0,0 +1,530 @@
+#include "lightphysics_surface_contact.h"
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+typedef struct node { double lo[3], hi[3]; int left, right, begin, end; } node_t;
+typedef struct embedded_context {
+    lightphysics_deformable_t *body;
+    const int32_t *ids;
+    const double *weights;
+    double *volume, *mass, minimum_fraction;
+    size_t *offset;
+    int32_t *surface_vertices;
+    uint32_t *seen, stamp;
+    int nvolume, volume_aware;
+    const lightphysics_surface_reduced_motion_t *motion;
+    lightphysics_status_t status;
+} embedded_context_t;
+struct lightphysics_surface_contact {
+    int nv,nf,ne,fn,en;
+    int32_t *faces,*edges,*forder,*eorder;
+    unsigned char *surface;
+    double *rest,*mass;
+    node_t *ftree,*etree;
+    embedded_context_t *embedded;
