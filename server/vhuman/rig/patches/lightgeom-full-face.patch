+static void test_cached_projector(void *context,double *x,const double *mass,double dt,int reset) {
+    (void)mass; (void)dt;
+    guard_cache_test_t *test=context;
+    if (reset || test->done) return;
+    test->done=1;
+    const int32_t first=0,neighbor=4;
+    const double compress[3]={-.031,-.031,-.031},second[3]={.006,0,0};
+    double fraction=0;
+    if (test->replacement) {
+        CHECK(lightphysics_deformable_snapshot_restore(test->body,test->replacement)==LIGHTPHYSICS_OK,
+              "cached reference replacement failed");
+    } else if (test->replacement_points) {
+        const float velocity[21]={0};
+        CHECK(lightphysics_deformable_write_state(test->body,test->replacement_points,velocity,21)==LIGHTPHYSICS_OK,
+              "cached reference write failed");
+    } else {
+        CHECK(lightphysics_deformable_project_guarded(test->body,&first,compress,1,&fraction)==LIGHTPHYSICS_OK,
+              "cached first correction failed");
+        CHECK(fraction>.999,"admissible cached first correction was limited");
+    }
+    /* The first correction leaves the shared neighbor at 7% volume, outside
+     * its original reference ball. The second displacement fits the original
+     * ball of vertex 4, but must invalidate that fast proof and stop at 5%. */
+    CHECK(lightphysics_deformable_project_guarded(test->body,&neighbor,second,1,&fraction)==LIGHTPHYSICS_OK,
+          "cached neighboring correction failed");
+    CHECK(fraction<.99,"stale neighboring reference ball was accepted");
+    double a[3],b[3],c[3];
+    for (int k=0;k<3;++k) {a[k]=x[12+k]-x[k];b[k]=x[15+k]-x[k];c[k]=x[18+k]-x[k];}
+    const double determinant=a[0]*(b[1]*c[2]-b[2]*c[1])-a[1]*(b[0]*c[2]-b[2]*c[0])+a[2]*(b[0]*c[1]-b[1]*c[0]);
+    CHECK(determinant/(-.001)>=.0499999,"cached proof allowed an inverted neighbor");
+}
