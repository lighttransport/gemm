+static void embedded_update_surface(lightphysics_surface_contact_t *c,double *x,
+    const int32_t *nodes,int count) {
+    embedded_context_t *e=c->embedded;
+    for (int j=0;j<count;++j) {
+        const int32_t node=nodes[j];
+        for (size_t at=e->offset[node];at<e->offset[node+1];++at) {
+            const int32_t v=e->surface_vertices[at];
+            if (e->seen[v]==e->stamp) continue;
+            e->seen[v]=e->stamp;
+            for (int k=0;k<3;++k) {
+                double value=0;
+                for (int m=0;m<4;++m) value+=e->weights[4*v+m]*e->volume[3*(size_t)e->ids[4*v+m]+k];
+                x[3*v+k]=value;
