+static void test_local_volume_contact(void) {
+    const float rest[12]={0,0,0,1,0,0,0,1,0,0,0,1};
+    const int32_t tet[4]={0,1,2,3},vertex=3;
+    const double gradient[3]={0,0,-1};
+    for (int fixed=0;fixed<2;++fixed) {
+        float inverse[4]={1,1,1,1};
+        if (fixed) inverse[0]=inverse[1]=inverse[2]=0;
+        lightphysics_deformable_desc_t desc={0};
+        desc.nverts=4;desc.rest_positions=rest;desc.inverse_mass=inverse;desc.ntets=1;desc.tets=tet;
+        lightphysics_deformable_options_t options;lightphysics_deformable_options_default(&options);
+        options.min_volume_ratio=.06f;
+        lightphysics_deformable_t *body=NULL;
+        CHECK(lightphysics_deformable_create(&desc,&options,&body)==LIGHTPHYSICS_OK,"local contact body create failed");
+        if (!body) continue;
+        double start[12],result[12],velocity[12]={0};
+        for (int k=0;k<12;++k) start[k]=rest[k];
+        start[11]=.06;
+        CHECK(lightphysics_deformable_write_state_f64(body,start,velocity,12)==LIGHTPHYSICS_OK,"local contact state write failed");
+        int32_t changed[LIGHTPHYSICS_CONTACT_MAX_VERTICES],count=-1;
+        double multiplier=-1,fraction=-1;
+        CHECK(lightphysics_deformable_project_contact_guarded(body,&vertex,gradient,1,.01,changed,
+              LIGHTPHYSICS_CONTACT_MAX_VERTICES,&count,&multiplier,&fraction)==LIGHTPHYSICS_OK,"local contact projection failed");
+        CHECK(lightphysics_deformable_read_state_f64(body,result,NULL,12)==LIGHTPHYSICS_OK,"local contact state read failed");
+        CHECK(count>=1 && count<=4,"local contact returned invalid support");
+        CHECK(fraction>=0 && fraction<=1 && multiplier>=0,"invalid local contact multiplier");
+        if (fixed) CHECK(fabs(result[11]-start[11])<1e-8,"infeasible contact crossed fixed barrier");
+        else {
+            CHECK(start[11]-result[11]>.0099,"local contact did not move free volume neighbors");
+            for (int k=0;k<3;++k) {
+                double momentum=0;
+                for (int j=0;j<4;++j) momentum+=result[3*j+k]-start[3*j+k];
+                CHECK(fabs(momentum-gradient[k]*multiplier)<1e-10,"local volume reactions do not balance");
+            }
+        }
+        for (int sample=0;sample<=100;++sample) {
+            float point[12];
+            for (int k=0;k<12;++k) point[k]=(float)(start[k]+sample*.01*(result[k]-start[k]));
+            CHECK(volume(point)>=.0599999/6,"local contact path violated signed-volume floor");
+        }
+        const double invalid[3]={NAN,0,0};const int32_t old_count=count;
+        CHECK(lightphysics_deformable_project_contact_guarded(body,&vertex,invalid,1,.01,changed,
+              LIGHTPHYSICS_CONTACT_MAX_VERTICES,&count,&multiplier,&fraction)==LIGHTPHYSICS_E_INVALID_ARGUMENT,
+              "local contact accepted nonfinite gradient");
+        CHECK(count==old_count,"invalid local contact changed output");
+        double after[12];lightphysics_deformable_read_state_f64(body,after,NULL,12);
+        CHECK(!memcmp(after,result,sizeof after),"invalid local contact mutated body");
+        lightphysics_deformable_destroy(body);
+    }
+}
