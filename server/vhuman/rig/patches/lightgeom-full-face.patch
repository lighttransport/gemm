+              "coupled joint-bound solve failed");
+        lightphysics_deformable_read_state_f64(body,result,NULL,12);
+        CHECK(fabs(dq[2])<1e-12 && fabs(result[11]-.07)<1e-10,"coupled attachment crossed an active joint bound");
+        lightphysics_deformable_destroy(body);
+    }
+}
