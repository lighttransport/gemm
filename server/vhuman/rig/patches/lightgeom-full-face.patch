+/* A fixed separating axis at both trajectory endpoints separates every
+ * interpolated point/convex feature as well. This is a continuous proof, not
+ * a sample-based miss test, and remains valid for deforming features. */
+static int swept_axis_separates(const double *old,const double *x,const int id[4],int ee,
+    const double axis[3],double shell) {
+    const double length=norm(axis);
+    if (!(length>1e-30) || !isfinite(length)) return 0;
+    double minimum=INFINITY,maximum=-INFINITY;
+    for (int state=0;state<2;++state) {
+        const double *points=state ? x : old;
+        for (int i=0;i<(ee ? 2 : 1);++i) for (int j=ee ? 2 : 1;j<4;++j) {
+            double difference[3];sub(points+3*id[i],points+3*id[j],difference);
+            const double value=dot(difference,axis)/length;
+            if (!isfinite(value)) return 0;
+            minimum=fmin(minimum,value);maximum=fmax(maximum,value);
+        }
+    }
+    return minimum>shell+1e-10 || maximum<-shell-1e-10;
+}
+static void contact_cross(const double a[3],const double b[3],double out[3]) {
+    out[0]=a[1]*b[2]-a[2]*b[1];out[1]=a[2]*b[0]-a[0]*b[2];out[2]=a[0]*b[1]-a[1]*b[0];
+}
+static int swept_feature_separated(const double *old,const double *x,const int id[4],int ee,
+    double shell,const double normal[3]) {
+    if (swept_axis_separates(old,x,id,ee,normal,shell)) return 1;
+    for (int k=0;k<3;++k) {
+        double axis[3]={0};axis[k]=1;
+        if (swept_axis_separates(old,x,id,ee,axis,shell)) return 1;
+    }
+    double a[2][3],b[2][3],axis[3];
+    for (int state=0;state<2;++state) {
+        const double *points=state ? x : old;
+        sub(points+3*id[ee ? 1 : 2],points+3*id[ee ? 0 : 1],a[state]);
+        sub(points+3*id[3],points+3*id[ee ? 2 : 1],b[state]);
+    }
+    for (int i=0;i<2;++i) for (int j=0;j<2;++j) {
+        contact_cross(a[i],b[j],axis);
+        if (swept_axis_separates(old,x,id,ee,axis,shell)) return 1;
+    }
+    if (ee) {
+        double relative[3];
+        for (int k=0;k<3;++k) relative[k]=x[3*id[2]+k]-old[3*id[2]+k]-x[3*id[0]+k]+old[3*id[0]+k];
+        for (int state=0;state<2;++state) {
+            contact_cross(a[state],relative,axis);
+            if (swept_axis_separates(old,x,id,ee,axis,shell)) return 1;
+            contact_cross(b[state],relative,axis);
+            if (swept_axis_separates(old,x,id,ee,axis,shell)) return 1;
+            const double *points=state ? x : old;double separation[3],temporary[3];
+            sub(points+3*id[0],points+3*id[2],separation);
+            contact_cross(separation,a[state],temporary);contact_cross(a[state],temporary,axis);
+            if (swept_axis_separates(old,x,id,ee,axis,shell)) return 1;
+            contact_cross(separation,b[state],temporary);contact_cross(b[state],temporary,axis);
+            if (swept_axis_separates(old,x,id,ee,axis,shell)) return 1;
+        }
+    }
+    return 0;
+}
