+        lightphysics_deformable_read_state_f64(body,result,NULL,12);
+        CHECK(result[11]>=.05999999,"coupled attachment violated volume floor");
+        CHECK(dq[2]>.0099 && fraction>.9999995,"blocked tissue failed to react back onto reduced coordinates");
+        CHECK(fabs(result[11]-x[11]-dq[2]-residual[2])<3e-9,"coupled attachment did not close");
