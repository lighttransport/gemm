+lightphysics_status_t lightphysics_deformable_prepare_guarded_projection(
+    lightphysics_deformable_t *body) {
+    if (!body) return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    if (body->incident_off) return LIGHTPHYSICS_OK;
+    const size_t nv=(size_t)body->nverts,nt=(size_t)body->ntets;
+    if (nv>(SIZE_MAX/sizeof(double)-1)/3 || nv>SIZE_MAX/sizeof(size_t)-1 ||
+        nt>(SIZE_MAX/sizeof(int32_t)-1)/4 || nt>SIZE_MAX/sizeof(uint32_t)-1)
+        return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    size_t *off = calloc((size_t)body->nverts + 1, sizeof(*off));
+    size_t *cursor = calloc((size_t)body->nverts + 1, sizeof(*cursor));
+    int32_t *list = malloc(((size_t)body->ntets * 4 + 1) * sizeof(*list));
+    uint32_t *seen = calloc((size_t)body->ntets + 1, sizeof(*seen));
+    double *reference = malloc(((size_t)body->nverts*3+1)*sizeof(*reference));
+    double *radius = malloc(((size_t)body->nverts+1)*sizeof(*radius));
+    unsigned char *invalid = calloc((size_t)body->nverts+1,1);
+    if (!off || !cursor || !list || !seen || !reference || !radius || !invalid) {
+        free(off); free(cursor); free(list); free(seen);
+        free(reference); free(radius); free(invalid);
+        return LIGHTPHYSICS_E_OUT_OF_MEMORY;
+    }
+    for (int32_t t=0;t<body->ntets;++t) for (int j=0;j<4;++j)
+        ++off[body->tets[4*t+j]+1];
+    for (int32_t i=0;i<body->nverts;++i) off[i+1] += off[i];
+    memcpy(cursor,off,((size_t)body->nverts+1)*sizeof(*off));
+    for (int32_t t=0;t<body->ntets;++t) for (int j=0;j<4;++j)
+        list[cursor[body->tets[4*t+j]]++] = t;
+    free(cursor);
+    body->incident_off=off; body->incident_tets=list; body->incident_seen=seen;
+    body->guard_reference=reference; body->guard_radius=radius; body->guard_invalid=invalid;
+    return LIGHTPHYSICS_OK;
+}
