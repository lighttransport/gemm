+    c->anchors=malloc(((size_t)count+1)*sizeof(int32_t));c->rigid=malloc(((size_t)rigid_count+1)*sizeof(int32_t));
+    c->rest=malloc(((size_t)count*3+1)*sizeof(double));c->rigid_rest=malloc(((size_t)rigid_count*3+1)*sizeof(double));
+    c->rigid_positions=malloc(((size_t)rigid_count*3+1)*sizeof(double));c->rigid_lookup=malloc(((size_t)nv+1)*sizeof(int32_t));
+    c->compliance=malloc(((size_t)count+1)*sizeof(double));c->lambda=calloc((size_t)count*3+1,sizeof(double));
+    if (!c->anchors || !c->rigid || !c->rest || !c->rigid_rest || !c->rigid_positions || !c->rigid_lookup || !c->compliance || !c->lambda) {
+        vhface_jaw_coupling_destroy(c);status=-2;goto done;
+    }
+    if (count) {memcpy(c->anchors,anchors,(size_t)count*sizeof(int32_t));memcpy(c->rest,rest,(size_t)count*3*sizeof(double));memcpy(c->compliance,compliance,(size_t)count*sizeof(double));}
+    if (rigid_count) {memcpy(c->rigid,rigid,(size_t)rigid_count*sizeof(int32_t));memcpy(c->rigid_rest,rigid_rest,(size_t)rigid_count*3*sizeof(double));}
+    for (int32_t i=0;i<nv;++i) c->rigid_lookup[i]=-1;
+    for (int32_t i=0;i<rigid_count;++i) c->rigid_lookup[rigid[i]]=i;
+    status=lightphysics_deformable_set_coupling_projector(body,jaw_coupling_project,c);
+    if (status!=LIGHTPHYSICS_OK) {vhface_jaw_coupling_destroy(c);goto done;}
+    c->body=body;*out=c;status=0;
+done:
+    free(mass);free(seen);free(tets);
+    return status;
+}
+
+int vhface_jaw_coupling_create(lightphysics_deformable_t *body,const double hinge[3],
+    const int32_t *anchors,const double *rest,const double *compliance,int32_t count,
+    const int32_t *rigid,const double *rigid_rest,int32_t rigid_count,vhface_jaw_coupling_t **out) {
+    return jaw_coupling_create_impl(body,hinge,anchors,rest,compliance,count,rigid,rigid_rest,rigid_count,out,NULL);
+}
+int vhface_jaw_coupling_create_model(lightphysics_deformable_t *body,const double hinge[3],const double track[3],
+    const int32_t *anchors,const double *rest,const double *compliance,int32_t count,
+    const int32_t *rigid,const double *rigid_rest,int32_t rigid_count,vhface_jaw_coupling_t **out) {
+    if (!track) {if(out)*out=NULL;return -1;}
+    return jaw_coupling_create_impl(body,hinge,anchors,rest,compliance,count,rigid,rigid_rest,rigid_count,out,track);
+}
+
+int vhface_jaw_coupling_prepare(vhface_jaw_coupling_t *c,const double q[3],const double inverse[3],double dt) {
+    if (!c || !q || !inverse || !isfinite(dt) || dt<=0 || dt>.01) return -1;
+    for (int k=0;k<3;++k) if (!isfinite(q[k]) || q[k]<jaw_low[k] || q[k]>jaw_high[k] ||
+        !isfinite(inverse[k]) || inverse[k]<0) return -1;
+    memcpy(c->q,q,3*sizeof(double));memcpy(c->inverse_inertia,inverse,3*sizeof(double));c->dt=dt;c->prepared=1;c->status=0;
+    return 0;
+}
+int vhface_jaw_coupling_read(const vhface_jaw_coupling_t *c,double q[3]) {
+    if (!c || !q || !c->prepared) return -1;
+    if (c->status) return c->status;
+    memcpy(q,c->q,3*sizeof(double));return 0;
+}
+int vhface_jaw_coupling_enable_volume_solve(vhface_jaw_coupling_t *c,int enabled) {
+    if (!c || (enabled!=0 && enabled!=1)) return -1;
+    c->volume_aware=enabled;return 0;
+}
+int vhface_jaw_coupling_enable_block_solve(vhface_jaw_coupling_t *c,int enabled) {
+    if (!c || (enabled!=0 && enabled!=1)) return -1;
+    if (enabled && !c->block_geometry) {
+        double *geometry=malloc(((size_t)c->count*12+1)*sizeof(double));
+        double *multipliers=malloc(((size_t)c->count*3+1)*sizeof(double));
+        double *delta=malloc(((size_t)c->count*3+1)*sizeof(double));
+        if (!geometry || !multipliers || !delta) {free(geometry);free(multipliers);free(delta);return -2;}
+        c->block_geometry=geometry;c->block_lambda=multipliers;c->block_delta=delta;
+    }
+    c->block_solve=enabled;return 0;
+}
+
+static lightphysics_status_t jaw_contact_read(void *context,const int32_t *vertices,
+    const double *gradient,int32_t count,double generalized[3],double inverse[3],
+    double q[3],double lower[3],double upper[3]) {
+    vhface_jaw_coupling_t *c=context;
+    if (!c || !c->prepared || c->status) return LIGHTPHYSICS_E_INVALID_STATE;
+    memset(generalized,0,3*sizeof(double));
+    const double cosine=cos(c->q[0]),sine=sin(c->q[0]);
+    int internal=1,has_gradient=0;
+    for (int j=0;j<count;++j) {
+        if (vertices[j]<0 || vertices[j]>=c->nvertices) return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+        const double *g=gradient+3*j;
+        if (g[0]==0 && g[1]==0 && g[2]==0) continue;
+        has_gradient=1;
+        const int32_t index=c->rigid_lookup[vertices[j]];
+        if (index<0) {internal=0;continue;}
+        const double *rest=c->rigid_rest+3*index;
+        double opening[3]={0,
+            -sine*(rest[1]-c->hinge[1])-cosine*(rest[2]-c->hinge[2])-.003333333333333333,
+            cosine*(rest[1]-c->hinge[1])-sine*(rest[2]-c->hinge[2])};
+        if (c->custom_track) {opening[0]=c->track[0];opening[1]+=c->track[1]+.003333333333333333;opening[2]+=c->track[2];}
+        for (int k=0;k<3;++k) generalized[0]+=g[k]*opening[k];
+        generalized[1]+=g[0];generalized[2]+=g[2];
+    }
+    /* A rigid group's internal gaps are invariant. Impact-time normals and
+     * roundoff must not create fictitious mobility between its own crowns. */
+    if (internal && has_gradient) memset(generalized,0,3*sizeof(double));
+    memcpy(inverse,c->inverse_inertia,3*sizeof(double));memcpy(q,c->q,3*sizeof(double));
+    memcpy(lower,jaw_low,3*sizeof(double));memcpy(upper,jaw_high,3*sizeof(double));
+    return LIGHTPHYSICS_OK;
+}
+
+static lightphysics_status_t jaw_contact_apply(void *context,const double delta[3],double *volume,
+    const int32_t **changed,int32_t *count) {
+    vhface_jaw_coupling_t *c=context;*changed=NULL;*count=0;
+    if (lightphysics_deformable_cancelled(c->body)) return LIGHTPHYSICS_E_CANCELLED;
+    double next[3];int moved=0;
+    for (int k=0;k<3;++k) {
+        next[k]=c->q[k]+delta[k];
+        if (!isfinite(next[k]) || next[k]<jaw_low[k]-1e-10 || next[k]>jaw_high[k]+1e-10)
+            return LIGHTPHYSICS_E_INVALID_STATE;
+        next[k]=fmax(jaw_low[k],fmin(jaw_high[k],next[k]));
+        if (next[k]!=c->q[k]) moved=1;
+    }
+    if (!moved) return LIGHTPHYSICS_OK;
+    if (c->custom_track ? vhface_jaw_transform_model(c->rigid_rest,c->rigid_count,c->hinge,next,c->track,c->rigid_positions) :
+            vhface_jaw_transform(c->rigid_rest,c->rigid_count,c->hinge,next,c->rigid_positions))
+        return LIGHTPHYSICS_E_INVALID_STATE;
+    if (c->rigid_count) {
+        lightphysics_status_t status=lightphysics_deformable_write_kinematic_positions_indexed_f64(c->body,c->rigid,
+            c->rigid_count,c->rigid_positions,(size_t)c->rigid_count*3);
+        if (status!=LIGHTPHYSICS_OK) return status;
+        for (int j=0;j<c->rigid_count;++j)
+            memcpy(volume+3*(size_t)c->rigid[j],c->rigid_positions+3*j,3*sizeof(double));
+    }
+    memcpy(c->q,next,3*sizeof(double));*changed=c->rigid;*count=c->rigid_count;
+    return LIGHTPHYSICS_OK;
+}
+
+int vhface_jaw_contact_project(vhface_jaw_coupling_t *c,lightphysics_surface_contact_t *contact,
+    const int32_t *ids,const double *weights,const double *previous,double *x,
+    double dt,double thickness,int32_t iterations,double *reaction,
+    lightphysics_surface_contact_stats_t *stats,double *minimum_fraction) {
+    if (!c || !c->prepared || c->status || !isfinite(dt) || fabs(c->dt-dt)>1e-12) return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    for (int j=0;j<c->rigid_count;++j) {
+        double expected[3],current[3];
+        if (c->custom_track ? vhface_jaw_transform_model(c->rigid_rest+3*j,1,c->hinge,c->q,c->track,expected) :
+                vhface_jaw_transform(c->rigid_rest+3*j,1,c->hinge,c->q,expected)) return LIGHTPHYSICS_E_INVALID_STATE;
+        lightphysics_status_t status=lightphysics_deformable_read_positions_indexed_f64(c->body,c->rigid+j,1,current,3);
+        if (status!=LIGHTPHYSICS_OK) return status;
+        for (int k=0;k<3;++k) if (fabs(expected[k]-current[k])>1e-10) return LIGHTPHYSICS_E_INVALID_STATE;
+    }
+    const lightphysics_surface_reduced_motion_t motion={c,jaw_contact_read,jaw_contact_apply};
+    return lightphysics_surface_contact_project_embedded_reduced(contact,c->body,ids,weights,previous,x,
+        dt,thickness,iterations,reaction,stats,minimum_fraction,&motion);
+}
