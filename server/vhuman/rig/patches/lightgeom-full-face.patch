+static void test_guarded_batch(void) {
+    const float rest[24]={0,0,0, 1,0,0, 0,1,0, 0,0,1,
+                          3,0,0, 4,0,0, 3,1,0, 3,0,1};
+    const int32_t tets[8]={0,1,2,3, 4,5,6,7};
+    int32_t vertices[8]={0,1,2,3,4,5,6,7};
+    double delta[24]={0};
+    for (int j=0;j<4;++j) {delta[3*j]=-2*rest[3*j];delta[3*j+1]=-2*rest[3*j+1];}
+    for (int j=4;j<8;++j) {delta[3*j]=.1;delta[3*j+1]=.2;delta[3*j+2]=.3;}
+    lightphysics_deformable_desc_t desc={0};
+    desc.nverts=8;desc.rest_positions=rest;desc.ntets=2;desc.tets=tets;
+    lightphysics_deformable_options_t options;
+    lightphysics_deformable_options_default(&options);options.min_volume_ratio=.06f;
+    lightphysics_deformable_t *body=NULL;
+    CHECK(lightphysics_deformable_create(&desc,&options,&body)==LIGHTPHYSICS_OK,"batch body create failed");
+    if (!body) return;
+    double fraction=0;
+    CHECK(lightphysics_deformable_project_guarded_batch(body,vertices,delta,8,&fraction)==LIGHTPHYSICS_OK,"batch correction failed");
+    /* Both endpoints have positive volume, but the path collapses halfway.
+     * The harmless translation of the second tet must use the same scale. */
+    CHECK(fraction>0 && fraction<.5,"batch missed an interior collapse");
+    float result[24],before[24];
+    CHECK(lightphysics_deformable_read_positions(body,result,24)==LIGHTPHYSICS_OK,"batch result read failed");
+    CHECK(volume(result)>=.0599999/6,"batch violated the volume floor");
+    for (int j=0;j<24;++j)
+        CHECK(fabs(result[j]-(rest[j]+fraction*delta[j]))<1e-6,"batch did not apply a common fraction");
+    memcpy(before,result,sizeof before);vertices[7]=vertices[6];
+    CHECK(lightphysics_deformable_project_guarded_batch(body,vertices,delta,8,&fraction)==LIGHTPHYSICS_E_INVALID_ARGUMENT,
+          "batch accepted repeated vertices");
+    vertices[7]=7;delta[23]=NAN;
+    CHECK(lightphysics_deformable_project_guarded_batch(body,vertices,delta,8,&fraction)==LIGHTPHYSICS_E_INVALID_ARGUMENT,
+          "batch accepted a nonfinite displacement");
+    CHECK(lightphysics_deformable_read_positions(body,result,24)==LIGHTPHYSICS_OK,"batch validation result read failed");
+    CHECK(!memcmp(before,result,sizeof before),"invalid batch mutated positions");
+    lightphysics_deformable_destroy(body);
+}
