+static void repair_inertial_prediction(lightphysics_deformable_t *body,double dt) {
+    /* Project only unsafe predicted tet motions onto their first separating
+     * volume tangent. This local mass projection preserves free translation;
+     * the continuous cubic guard below remains the feasibility authority. */
+    for (int sweep=0;sweep<body->inertial_repair_sweeps;++sweep) {
+        int changed=0;
+        for (int32_t at=0;at<body->ntets;++at) {
+            if ((at&63)==0 && lightphysics_deformable_cancelled(body)) return;
+            const int32_t t=(sweep&1) ? body->ntets-1-at : at;
+            const int32_t *ids=body->tets+4*t;
+            double base[4][3],delta[4][3],boundary[4][3],gradient[4][3];
+            for (int j=0;j<4;++j) for (int k=0;k<3;++k) {
+                base[j][k]=body->xprev[3*ids[j]+k];
+                delta[j][k]=body->x[3*ids[j]+k]-base[j][k];
+            }
+            const double fraction=guarded_tet_fraction(body,t,base,delta,1);
+            if (fraction>=1) continue;
+            for (int j=0;j<4;++j) for (int k=0;k<3;++k)
+                boundary[j][k]=base[j][k]+fraction*delta[j][k];
+            tetra_gradients(&boundary[0][0],0,1,2,3,gradient);
+            const double sign=body->rest_volume[t]>=0 ? 1 : -1;
+            double derivative=0,denominator=0,largest=0;
+            for (int j=0;j<4;++j) {
+                for (int k=0;k<3;++k) {
+                    gradient[j][k]*=sign;
+                    derivative+=gradient[j][k]*delta[j][k];
+                    largest=fmax(largest,fabs(delta[j][k]));
+                }
+                denominator+=body->inverse_mass[ids[j]]*dot3(gradient[j],gradient[j]);
+            }
+            const double violation=-(1-fraction)*derivative+1e-8*fabs(body->rest_volume[t]);
+            if (!(violation>0) || !(denominator>1e-300) || !isfinite(denominator)) continue;
+            double multiplier=violation/denominator,correction[4][3],maximum=0;
+            if (!isfinite(multiplier)) continue;
+            for (int j=0;j<4;++j) for (int k=0;k<3;++k) {
+                correction[j][k]=body->inverse_mass[ids[j]]*gradient[j][k]*multiplier;
+                maximum=fmax(maximum,fabs(correction[j][k]));
+            }
+            /* An ill-conditioned tangent must not create an unbounded
+             * proposal. Incomplete repairs are handled by the exact guard. */
+            if (!(maximum>0) || !isfinite(maximum)) continue;
+            const double scale=fmin(1,4*fmax(largest,1e-12)/maximum);
+            int finite=1;
+            for (int j=0;j<4;++j) for (int k=0;k<3;++k) {
+                correction[j][k]*=scale;
+                if (!isfinite(body->x[3*ids[j]+k]+correction[j][k]) ||
+                    !isfinite(body->v[3*ids[j]+k]+correction[j][k]/dt)) finite=0;
+            }
+            if (!finite) continue;
+            for (int j=0;j<4;++j) for (int k=0;k<3;++k) {
+                body->x[3*ids[j]+k]+=correction[j][k];
+                body->v[3*ids[j]+k]+=correction[j][k]/dt;
+            }
+            ++changed;
+        }
+        if (!changed) break;
+    }
+}
