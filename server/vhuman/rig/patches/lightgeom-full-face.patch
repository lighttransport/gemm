+        if(dot(cross,cross)<1e-36)return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    }
+    lightphysics_surface_contact_t *c=calloc(1,sizeof *c);if(!c)return LIGHTPHYSICS_E_OUT_OF_MEMORY;
+    c->nv=nv;c->nf=nf;
+    c->faces=malloc((size_t)nf*3*sizeof(int32_t));c->edges=malloc((size_t)nf*6*sizeof(int32_t));c->surface=calloc((size_t)nv,1);
+    c->rest=malloc((size_t)nv*3*sizeof(double));c->mass=malloc((size_t)nv*sizeof(double));c->forder=malloc((size_t)nf*sizeof(int32_t));
+    c->ftree=calloc((size_t)nf*2,sizeof(node_t));c->etree=calloc((size_t)nf*6,sizeof(node_t));c->eorder=malloc((size_t)nf*3*sizeof(int32_t));
+    if(!c->faces||!c->edges||!c->surface||!c->rest||!c->mass||!c->forder||!c->ftree||!c->etree||!c->eorder){lightphysics_surface_contact_destroy(c);return LIGHTPHYSICS_E_OUT_OF_MEMORY;}
+    memcpy(c->faces,faces,(size_t)nf*3*sizeof(int32_t));memcpy(c->rest,rest,(size_t)nv*3*sizeof(double));memcpy(c->mass,mass,(size_t)nv*sizeof(double));
+    for(int i=0;i<nf;++i){c->forder[i]=i;for(int j=0;j<3;++j){int a=faces[3*i+j],b=faces[3*i+(j+1)%3];if(a==b){lightphysics_surface_contact_destroy(c);return LIGHTPHYSICS_E_INVALID_ARGUMENT;}c->surface[a]=1;c->edges[6*i+2*j]=a<b?a:b;c->edges[6*i+2*j+1]=a<b?b:a;}}
+    qsort(c->edges,(size_t)nf*3,2*sizeof(int32_t),edge_compare);
+    for(int i=0;i<3*nf;++i)if(i==0||edge_compare(c->edges+2*i,c->edges+2*(i-1))){c->edges[2*c->ne]=c->edges[2*i];c->edges[2*c->ne+1]=c->edges[2*i+1];++c->ne;}
+    for(int i=0;i<c->ne;++i)c->eorder[i]=i;
+    *out=c;return LIGHTPHYSICS_OK;
+}
+lightphysics_status_t lightphysics_surface_contact_project(lightphysics_surface_contact_t *c,const double *old,double *x,double dt,double h,int32_t iterations,double *reaction,lightphysics_surface_contact_stats_t *stats){
+    if(!c||!old||!x||!stats||!isfinite(dt)||dt<=0||!isfinite(h)||h<0||iterations<1||iterations>128)return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    for(int i=0;i<3*c->nv;++i)if(!isfinite(old[i])||!isfinite(x[i]))return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    memset(stats,0,sizeof *stats);if(reaction)memset(reaction,0,(size_t)c->nv*3*sizeof(double));
+    for(int it=0;it<iterations;++it){
+        /* Tree ordering is derived scratch, never persistent trial state. */
+        for(int i=0;i<c->nf;++i)c->forder[i]=i;
+        for(int i=0;i<c->ne;++i)c->eorder[i]=i;
+        c->fn=c->en=0;build_tree(c->ftree,&c->fn,c->forder,0,c->nf,c->faces,3,old,x,h);build_tree(c->etree,&c->en,c->eorder,0,c->ne,c->edges,2,old,x,h);
+        for(int v=0;v<c->nv;++v)if(c->surface[v]){double lo[3],hi[3];for(int k=0;k<3;++k){lo[k]=fmin(old[3*v+k],x[3*v+k])-h;hi[k]=fmax(old[3*v+k],x[3*v+k])+h;}query(c,0,v,0,lo,hi,old,x,dt,h,reaction,stats);if(c->embedded && c->embedded->status!=LIGHTPHYSICS_OK)return c->embedded->status;}
+        for(int e=0;e<c->ne;++e){double lo[3],hi[3];for(int k=0;k<3;++k){lo[k]=INFINITY;hi[k]=-INFINITY;for(int j=0;j<2;++j){int v=c->edges[2*e+j];lo[k]=fmin(lo[k],fmin(old[3*v+k],x[3*v+k])-h);hi[k]=fmax(hi[k],fmax(old[3*v+k],x[3*v+k])+h);}}query(c,0,e,1,lo,hi,old,x,dt,h,reaction,stats);if(c->embedded && c->embedded->status!=LIGHTPHYSICS_OK)return c->embedded->status;}
+    }
+    return LIGHTPHYSICS_OK;
+}
+
+static lightphysics_status_t project_embedded_impl(
+    lightphysics_surface_contact_t *c,lightphysics_deformable_t *body,
+    const int32_t *ids,const double *weights,const double *old,double *x,
+    double dt,double h,int32_t iterations,double *reaction,
+    lightphysics_surface_contact_stats_t *stats,double *minimum_fraction,int volume_aware,
+    const lightphysics_surface_reduced_motion_t *motion) {
+    if (!c || !body || !ids || !weights || !old || !x || !stats ||
+        !minimum_fraction || c->embedded || !isfinite(dt) || dt<=0 ||
+        !isfinite(h) || h<0 || iterations<1 || iterations>128)
+        return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    if (motion && (!motion->read || !motion->apply)) return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    const int nv=lightphysics_deformable_num_vertices(body);
+    if (nv<1 || (size_t)nv>SIZE_MAX/sizeof(double)/3 ||
+        (size_t)c->nv>SIZE_MAX/sizeof(int32_t)/4)
+        return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    for (int v=0;v<c->nv;++v) {
+        double sum=0,amplification=0;
+        for (int j=0;j<4;++j) {
+            if (ids[4*v+j]<0 || ids[4*v+j]>=nv || !isfinite(weights[4*v+j]))
+                return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+            sum+=weights[4*v+j];amplification+=fabs(weights[4*v+j]);
+        }
+        if (fabs(sum-1)>1e-8 || amplification>3.00000001)
+            return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+        for (int k=0;k<3;++k)
+            if (!isfinite(old[3*v+k]) || !isfinite(x[3*v+k]))
+                return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    }
+    embedded_context_t e={0};
+    e.body=body;e.ids=ids;e.weights=weights;e.nvolume=nv;e.minimum_fraction=1;e.volume_aware=volume_aware;e.motion=motion;
+    e.volume=malloc((size_t)nv*3*sizeof(double));
+    e.mass=malloc((size_t)nv*sizeof(double));
+    e.offset=calloc((size_t)nv+1,sizeof(size_t));
+    e.surface_vertices=malloc((size_t)c->nv*4*sizeof(int32_t));
+    e.seen=calloc((size_t)c->nv,sizeof(uint32_t));
+    float *mass=malloc((size_t)nv*sizeof(float));
+    size_t *cursor=malloc(((size_t)nv+1)*sizeof(size_t));
+    lightphysics_status_t status=LIGHTPHYSICS_E_OUT_OF_MEMORY;
+    if (!e.volume || !e.mass || !e.offset || !e.surface_vertices || !e.seen || !mass || !cursor)
+        goto done;
+    status=lightphysics_deformable_read_inverse_masses(body,mass,nv);
+    if (status==LIGHTPHYSICS_OK)
+        status=lightphysics_deformable_read_state_f64(body,e.volume,NULL,(size_t)nv*3);
+    if (status!=LIGHTPHYSICS_OK) goto done;
+    for (int v=0;v<nv;++v) {
+        e.mass[v]=mass[v];
+        if (!isfinite(e.mass[v]) || e.mass[v]<0) {status=LIGHTPHYSICS_E_INVALID_STATE;goto done;}
+        for (int k=0;k<3;++k)
+            if (!isfinite(e.volume[3*v+k])) {status=LIGHTPHYSICS_E_INVALID_STATE;goto done;}
+    }
+    for (int v=0;v<c->nv;++v) {
+        for (int k=0;k<3;++k) {
+            double expected=0;
+            for (int j=0;j<4;++j)
+                expected+=weights[4*v+j]*e.volume[3*(size_t)ids[4*v+j]+k];
+            if (!isfinite(expected) || fabs(expected-x[3*v+k])>1e-10) {
+                status=LIGHTPHYSICS_E_INVALID_STATE;goto done;
+            }
+        }
+        for (int j=0;j<4;++j) if (weights[4*v+j]!=0)
+            ++e.offset[ids[4*v+j]+1];
+    }
+    for (int v=0;v<nv;++v) e.offset[v+1]+=e.offset[v];
+    memcpy(cursor,e.offset,((size_t)nv+1)*sizeof(size_t));
+    for (int v=0;v<c->nv;++v) for (int j=0;j<4;++j) if (weights[4*v+j]!=0)
+        e.surface_vertices[cursor[ids[4*v+j]]++]=v;
+    c->embedded=&e;
+    status=lightphysics_surface_contact_project(c,old,x,dt,h,iterations,reaction,stats);
+    c->embedded=NULL;
+    if (e.status!=LIGHTPHYSICS_OK) status=e.status;
+    *minimum_fraction=e.minimum_fraction;
+done:
+    free(e.volume);free(e.mass);free(e.offset);free(e.surface_vertices);free(e.seen);
+    free(mass);free(cursor);
+    return status;
+}
+
+lightphysics_status_t lightphysics_surface_contact_project_embedded(
+    lightphysics_surface_contact_t *c,lightphysics_deformable_t *body,
+    const int32_t *ids,const double *weights,const double *old,double *x,
+    double dt,double h,int32_t iterations,double *reaction,
+    lightphysics_surface_contact_stats_t *stats,double *minimum_fraction) {
+    return project_embedded_impl(c,body,ids,weights,old,x,dt,h,iterations,reaction,stats,minimum_fraction,0,NULL);
+}
+
+lightphysics_status_t lightphysics_surface_contact_project_embedded_volume(
+    lightphysics_surface_contact_t *c,lightphysics_deformable_t *body,
+    const int32_t *ids,const double *weights,const double *old,double *x,
+    double dt,double h,int32_t iterations,double *reaction,
+    lightphysics_surface_contact_stats_t *stats,double *minimum_fraction) {
+    return project_embedded_impl(c,body,ids,weights,old,x,dt,h,iterations,reaction,stats,minimum_fraction,1,NULL);
+}
+
+lightphysics_status_t lightphysics_surface_contact_project_embedded_reduced(
+    lightphysics_surface_contact_t *c,lightphysics_deformable_t *body,
+    const int32_t *ids,const double *weights,const double *old,double *x,
+    double dt,double h,int32_t iterations,double *reaction,
+    lightphysics_surface_contact_stats_t *stats,double *minimum_fraction,
+    const lightphysics_surface_reduced_motion_t *motion) {
+    return project_embedded_impl(c,body,ids,weights,old,x,dt,h,iterations,reaction,stats,minimum_fraction,2,motion);
+}
+
+static int segment_triangle(const double *a,const double *b,const double *p,const double *q,const double *r) {
+    double d[3],e[3],f[3],h[3],s[3],v[3];sub(b,a,d);sub(q,p,e);sub(r,p,f);
+    h[0]=d[1]*f[2]-d[2]*f[1];h[1]=d[2]*f[0]-d[0]*f[2];h[2]=d[0]*f[1]-d[1]*f[0];
+    double det=dot(e,h);
+    if(fabs(det)<1e-20)return 0;
+    sub(a,p,s);double u=dot(s,h)/det;
+    if(u<=1e-7||u>=1-1e-7)return 0;
+    v[0]=s[1]*e[2]-s[2]*e[1];v[1]=s[2]*e[0]-s[0]*e[2];v[2]=s[0]*e[1]-s[1]*e[0];
+    double w=dot(d,v)/det,t=dot(f,v)/det;
+    return w>1e-7&&u+w<1-1e-7&&t>1e-7&&t<1-1e-7;
+}
+static uint64_t count_crossings(const lightphysics_surface_contact_t *c,int node,int edge,
+                                const double *lo,const double *hi,const double *x,
+                                int32_t *records,size_t capacity,uint64_t offset) {
+    const node_t *n=&c->ftree[node];
+    if(!overlap(n,lo,hi))return 0;
+    if(n->left>=0){
+        uint64_t left=count_crossings(c,n->left,edge,lo,hi,x,records,capacity,offset);
+        return left+count_crossings(c,n->right,edge,lo,hi,x,records,capacity,offset+left);
+    }
+    int a=c->edges[2*edge],b=c->edges[2*edge+1];uint64_t count=0;
+    for(int i=n->begin;i<n->end;++i){
+        const int32_t *f=c->faces+3*c->forder[i];int skip=0;
+        for(int j=0;j<3;++j)skip|=adjacent(c,a,f[j])||adjacent(c,b,f[j]);
+        if(!skip&&segment_triangle(x+3*a,x+3*b,x+3*f[0],x+3*f[1],x+3*f[2])){
+            if(offset+count<capacity){
+                int32_t *record=records+5*(size_t)(offset+count);
+                record[0]=a;record[1]=b;memcpy(record+2,f,3*sizeof(int32_t));
+            }
+            ++count;
+        }
+    }
+    return count;
+}
+lightphysics_status_t lightphysics_surface_contact_count_intersections(
+    lightphysics_surface_contact_t *c,const double *x,uint64_t *out) {
+    return lightphysics_surface_contact_find_intersections(c,x,NULL,0,out);
+}
+lightphysics_status_t lightphysics_surface_contact_find_intersections(
+    lightphysics_surface_contact_t *c,const double *x,int32_t *records,size_t capacity,uint64_t *out) {
+    if(!c||!x||!out||(!records&&capacity)||capacity>SIZE_MAX/(5*sizeof(int32_t)))return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    for(int i=0;i<3*c->nv;++i)if(!isfinite(x[i]))return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    *out=0;c->fn=0;
+    for(int i=0;i<c->nf;++i)c->forder[i]=i;
+    build_tree(c->ftree,&c->fn,c->forder,0,c->nf,c->faces,3,x,x,0);
+    for(int e=0;e<c->ne;++e){double lo[3],hi[3];int a=c->edges[2*e],b=c->edges[2*e+1];
+        for(int k=0;k<3;++k){lo[k]=fmin(x[3*a+k],x[3*b+k]);hi[k]=fmax(x[3*a+k],x[3*b+k]);}
+        *out+=count_crossings(c,0,e,lo,hi,x,records,capacity,*out);
+    }
+    return LIGHTPHYSICS_OK;
+}
