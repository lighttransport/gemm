+        if (!body) continue;
+        double x[12],velocity[12]={0},result[12];for (int k=0;k<12;++k) x[k]=rest[k];x[11]=.06;
+        double q[3]={0,0,.05},inverse[3]={0,0,1},low[3]={0,0,0},high[3]={.48,.004,.2};
+        double residual[3]={0,0,-.01},jacobian[9]={0,0,0,0,0,0,0,0,1};
