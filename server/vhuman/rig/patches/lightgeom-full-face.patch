+static double guarded_tet_fraction(const lightphysics_deformable_t *body,int32_t t,
+    double base[4][3],double delta[4][3],double fraction) {
+    int moved=0;
+    for (int j=0;j<4;++j)
+        if (delta[j][0]!=0 || delta[j][1]!=0 || delta[j][2]!=0) ++moved;
+    if (!moved) return fraction;
+    if (moved==1) {
+        /* Most neighboring tetrahedra share just one corrected vertex. Their
+         * determinant path is affine, so no cubic or root search is needed. */
+        const double sign=body->rest_volume[t]>=0 ? 1 : -1;
+        const double current=sign*tetra_volume(&base[0][0],0,1,2,3);
+        if (!(current>0) || !isfinite(current)) return 0;
+        double next[4][3];
+        for (int j=0;j<4;++j) for (int c=0;c<3;++c)
+            next[j][c]=base[j][c]+delta[j][c];
+        const double endpoint=sign*tetra_volume(&next[0][0],0,1,2,3);
+        if (!isfinite(endpoint)) return 0;
+        const double floor=fmin(fabs(body->rest_volume[t])*body->options.min_volume_ratio,current*(1-1e-10));
+        if (endpoint<floor) {
+            const double root=(current-floor)/(current-endpoint);
+            if (root<fraction) fraction=fmax(0,root)*(1-1e-8);
+        }
+        return fraction;
+    }
+    double edge[3][3],change[3][3];
+    for (int k=0;k<3;++k) for (int c=0;c<3;++c) {
+        edge[k][c]=base[k+1][c]-base[0][c];
+        change[k][c]=delta[k+1][c]-delta[0][c];
+    }
+    const double sign=body->rest_volume[t]>=0 ? 1 : -1;
+    double coefficients[4]={
+        triple_product(edge[0],edge[1],edge[2]),
+        triple_product(change[0],edge[1],edge[2])+triple_product(edge[0],change[1],edge[2])+triple_product(edge[0],edge[1],change[2]),
+        triple_product(change[0],change[1],edge[2])+triple_product(change[0],edge[1],change[2])+triple_product(edge[0],change[1],change[2]),
+        triple_product(change[0],change[1],change[2])};
+    for (int k=0;k<4;++k) coefficients[k]*=sign/6.;
+    const double current=coefficients[0];
+    if (!(current>0) || !isfinite(current)) return 0;
+    const double floor=fmin(fabs(body->rest_volume[t])*body->options.min_volume_ratio,current*(1-1e-10));
+    coefficients[0]-=floor;
+    int finite=1;
+    for (int k=0;k<4;++k) if (!isfinite(coefficients[k])) finite=0;
+    if (!finite) return 0;
+    /* Finite determinant coefficients can still overflow the derivative's
+     * discriminant. Scale only extreme polynomials, retaining the ordinary
+     * metre-space arithmetic exactly. Positive scaling preserves every root
+     * and sign along the correction path. */
+    if (fabs(coefficients[0])>1e100 || fabs(coefficients[1])>1e100 ||
+        fabs(coefficients[2])>1e100 || fabs(coefficients[3])>1e100) {
+        double magnitude=0;
+        for (int k=0;k<4;++k) magnitude=fmax(magnitude,fabs(coefficients[k]));
+        for (int k=0;k<4;++k) coefficients[k]/=magnitude;
+    }
+    if (!cubic_admissible(coefficients,fraction)) {
+        double lo=0,hi=fraction;
+        for (int it=0;it<40;++it) {
+            const double mid=.5*(lo+hi);
+            if (cubic_admissible(coefficients,mid)) lo=mid; else hi=mid;
+        }
+        fraction=lo*(1-1e-8);
+    }
+    return fraction;
+}
