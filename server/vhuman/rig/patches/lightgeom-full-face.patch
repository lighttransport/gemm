+static void guard_inertial_prediction(lightphysics_deformable_t *body) {
+    for (int32_t c=0;c<body->guard_component_count;++c) {
+        memset(body->guard_components+c,0,sizeof *body->guard_components);
+        body->guard_components[c].fraction=1;
+        body->guard_components[c].free=1;
+    }
+    for (int32_t i=0;i<body->nverts;++i) {
+        const int32_t index=body->guard_component[i];
+        if (index<0) continue; /* Unconstrained particles have no tet barrier. */
+        deformable_guard_component_t *component=body->guard_components+index;
+        const double inverse=body->inverse_mass[i];
+        if (inverse<=0) {component->free=0;continue;}
+        const double mass=1/inverse;
+        component->mass+=mass;
+        for (int c=0;c<3;++c) {
+            component->translation[c]+=mass*(body->x[3*i+c]-body->xprev[3*i+c]);
+            component->mean_velocity[c]+=mass*body->v[3*i+c];
+        }
+    }
+    for (int32_t index=0;index<body->guard_component_count;++index) {
+        deformable_guard_component_t *component=body->guard_components+index;
+        if (component->free && component->mass>0 && isfinite(component->mass)) {
+            for (int c=0;c<3;++c) {
+                component->translation[c]/=component->mass;
+                component->mean_velocity[c]/=component->mass;
+                if (!isfinite(component->translation[c]) || !isfinite(component->mean_velocity[c])) component->free=0;
+            }
+        } else component->free=0;
+        if (!component->free) for (int c=0;c<3;++c)
+            component->translation[c]=component->mean_velocity[c]=0;
+    }
+    for (int32_t t=0;t<body->ntets;++t) {
+        const int32_t *ids=body->tets+4*t;
+        deformable_guard_component_t *component=body->guard_components+body->guard_component[ids[0]];
+        if (!component->fraction) continue;
+        double base[4][3],delta[4][3];
+        for (int j=0;j<4;++j) for (int c=0;c<3;++c) {
+            base[j][c]=body->xprev[3*ids[j]+c];
+            delta[j][c]=body->x[3*ids[j]+c]-base[j][c];
+        }
+        component->fraction=guarded_tet_fraction(body,t,base,delta,component->fraction);
+    }
+    body->guard_prediction_valid=1;
+    for (int32_t i=0;i<body->nverts;++i) {
+        const int32_t index=body->guard_component[i];
+        if (index<0 || body->inverse_mass[i]<=0) continue;
+        const deformable_guard_component_t *component=body->guard_components+index;
+        if (component->fraction>=1) continue;
+        for (int c=0;c<3;++c) {
+            const int32_t k=3*i+c;
+            /* Preserve each free tissue component's translation, without
+             * spreading another component's feasibility limit or momentum. */
+            body->x[k]=body->xprev[k]+component->translation[c]+component->fraction*(body->x[k]-body->xprev[k]-component->translation[c]);
+            body->v[k]=component->mean_velocity[c]+component->fraction*(body->v[k]-component->mean_velocity[c]);
+        }
+    }
+}
+
+lightphysics_status_t lightphysics_deformable_enable_guarded_solve(
+    lightphysics_deformable_t *body,int enabled) {
+    if (!body || (enabled!=0 && enabled!=1)) return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    if (enabled) {
+        lightphysics_status_t status=lightphysics_deformable_prepare_guarded_projection(body);
+        if (status!=LIGHTPHYSICS_OK) return status;
+        status=prepare_guard_components(body);
+        if (status!=LIGHTPHYSICS_OK) return status;
+    }
+    body->guarded_solve=enabled;
+    return LIGHTPHYSICS_OK;
+}
+
+static lightphysics_status_t project_guarded_small(
+    lightphysics_deformable_t *body,const int32_t *vertices,
+    const double *displacements,int32_t count,double *out_fraction) {
+    if (!body || !vertices || !displacements || !out_fraction || count<1 || count>16)
+        return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    double correction[48];
+    memcpy(correction,displacements,(size_t)count*3*sizeof(double));
+    displacements=correction;
+    int changed=0;
+    for (int j=0;j<count;++j) {
+        if (!valid_index(vertices[j],body->nverts)) return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+        for (int k=0;k<j;++k) if (vertices[k]==vertices[j]) return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+        for (int c=0;c<3;++c) {
+            if (!isfinite(displacements[3*j+c])) return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+            if (!isfinite(body->x[3*vertices[j]+c]+displacements[3*j+c])) return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+            if (displacements[3*j+c]!=0) changed=1;
+        }
+    }
+    if (!changed) {*out_fraction=1;return LIGHTPHYSICS_OK;}
+    if (body->guard_cache_valid) {
+        int safe=1;
+        for (int j=0;j<count && safe;++j) {
+            const int32_t v=vertices[j];
+            double before=0,after=0;
+            for (int c=0;c<3;++c) {
+                const double d=body->x[3*v+c]-body->guard_reference[3*v+c];
+                before+=d*d;
+                after+=(d+displacements[3*j+c])*(d+displacements[3*j+c]);
+            }
+            const double radius=body->guard_radius[v];
+            if (body->guard_invalid[v] || before>radius*radius || after>radius*radius) safe=0;
+        }
+        if (safe) {
+            for (int j=0;j<count;++j) for (int c=0;c<3;++c)
+                body->x[3*vertices[j]+c]+=displacements[3*j+c];
+            *out_fraction=1;
+            return LIGHTPHYSICS_OK;
+        }
+    }
+    lightphysics_status_t status=lightphysics_deformable_prepare_guarded_projection(body);
+    if (status!=LIGHTPHYSICS_OK) return status;
+    if (++body->incident_stamp==0) {
+        memset(body->incident_seen,0,(size_t)body->ntets*sizeof(*body->incident_seen));
+        body->incident_stamp=1;
+    }
+    double fraction=1;
+    for (int j=0;j<count;++j) {
+        for (size_t at=body->incident_off[vertices[j]];at<body->incident_off[vertices[j]+1];++at) {
+            int32_t t=body->incident_tets[at];
+            if (body->incident_seen[t]==body->incident_stamp) continue;
+            body->incident_seen[t]=body->incident_stamp;
+            const int32_t *ids=body->tets+4*t;
+            double delta[4][3]={{0}};
+            for (int k=0;k<4;++k) for (int m=0;m<count;++m)
+                if (ids[k]==vertices[m]) memcpy(delta[k],displacements+3*m,3*sizeof(double));
+            double base[4][3];
+            for (int k=0;k<4;++k)
+                memcpy(base[k],body->x+3*ids[k],3*sizeof(double));
+            fraction=guarded_tet_fraction(body,t,base,delta,fraction);
+        }
+        if (!fraction) break;
+    }
+    for (int j=0;j<count;++j) for (int c=0;c<3;++c)
+        body->x[3*vertices[j]+c]+=fraction*displacements[3*j+c];
+    if (body->guard_cache_valid) for (int j=0;j<count;++j) {
+        const int32_t v=vertices[j];
+        double displacement[3]; sub3(body->x+3*v,body->guard_reference+3*v,displacement);
+        const double radius=body->guard_radius[v];
+        if (dot3(displacement,displacement)>radius*radius) {
+            /* A vertex outside its ball invalidates fast paths at every
+             * vertex of each incident tet. Unaffected neighborhoods retain
+             * their proof; the next sweep rebuilds all reference balls. */
+            for (size_t at=body->incident_off[v];at<body->incident_off[v+1];++at) {
+                const int32_t t=body->incident_tets[at];
+                for (int k=0;k<4;++k) body->guard_invalid[body->tets[4*t+k]]=1;
+            }
+        }
+    }
+    *out_fraction=fraction;
+    return LIGHTPHYSICS_OK;
+}
+
+lightphysics_status_t lightphysics_deformable_project_guarded(
+    lightphysics_deformable_t *body,const int32_t *vertices,
+    const double *displacements,int32_t count,double *out_fraction) {
+    if (count>4) return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    return project_guarded_small(body,vertices,displacements,count,out_fraction);
+}
+
+lightphysics_status_t lightphysics_deformable_project_guarded_batch(
+    lightphysics_deformable_t *body,const int32_t *vertices,
+    const double *displacements,int32_t count,double *out_fraction) {
+    if (!body || !vertices || !displacements || !out_fraction || count<1 || count>body->nverts)
+        return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    if (count<=16)
+        return project_guarded_small(body,vertices,displacements,count,out_fraction);
+    double *delta=calloc((size_t)body->nverts*3,sizeof(double));
+    unsigned char *seen=calloc((size_t)body->nverts,1);
+    if (!delta || !seen) {free(delta);free(seen);return LIGHTPHYSICS_E_OUT_OF_MEMORY;}
+    lightphysics_status_t status=LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    int changed=0;
+    for (int32_t j=0;j<count;++j) {
+        const int32_t v=vertices[j];
+        if (!valid_index(v,body->nverts) || seen[v]) goto done;
+        seen[v]=1;
+        for (int c=0;c<3;++c) {
+            const double d=displacements[3*j+c];
+            if (!isfinite(d) || !isfinite(body->x[3*v+c]+d)) goto done;
+            delta[3*v+c]=d;
+            if (d!=0) changed=1;
+        }
+    }
+    if (!changed) {*out_fraction=1;status=LIGHTPHYSICS_OK;goto done;}
+    status=lightphysics_deformable_prepare_guarded_projection(body);
+    if (status!=LIGHTPHYSICS_OK) goto done;
+    if (++body->incident_stamp==0) {
+        memset(body->incident_seen,0,(size_t)body->ntets*sizeof(*body->incident_seen));
+        body->incident_stamp=1;
+    }
+    double fraction=1;
+    for (int32_t j=0;j<count && fraction>0;++j) {
+        const int32_t v=vertices[j];
+        for (size_t at=body->incident_off[v];at<body->incident_off[v+1];++at) {
+            const int32_t t=body->incident_tets[at];
+            if (body->incident_seen[t]==body->incident_stamp) continue;
+            body->incident_seen[t]=body->incident_stamp;
+            const int32_t *ids=body->tets+4*t;
+            double base[4][3],correction[4][3];
+            for (int k=0;k<4;++k) {
+                memcpy(base[k],body->x+3*ids[k],3*sizeof(double));
+                memcpy(correction[k],delta+3*ids[k],3*sizeof(double));
+            }
+            fraction=guarded_tet_fraction(body,t,base,correction,fraction);
+        }
+    }
+    for (int32_t j=0;j<count;++j) for (int c=0;c<3;++c)
+        body->x[3*vertices[j]+c]+=fraction*delta[3*vertices[j]+c];
+    body->guard_cache_valid=0;
+    *out_fraction=fraction;
+    status=LIGHTPHYSICS_OK;
+done:
+    free(delta);free(seen);
+    return status;
+}
+
+/* Sparse dual coordinate descent for a contact and nearby volume barriers.
+ * Work is bounded independently of the complete tetrahedral mesh size. */
+#define CONTACT_LOCAL_TETS 64
+#define CONTACT_LOCAL_ROWS (CONTACT_LOCAL_TETS + 1)
+typedef struct contact_local_row {
+    int count, local[16];
+    double gradient[16][3], rhs, multiplier, scale;
+    int32_t tet;
+} contact_local_row_t;
+
+static int contact_local_index(const int32_t *nodes,int count,int32_t vertex) {
+    for (int j=0;j<count;++j) if (nodes[j]==vertex) return j;
+    return -1;
+}
+
+static double contact_local_fraction(lightphysics_deformable_t *body,
+    const int32_t *nodes,int count,double delta[][3],int32_t *blocked,int *nblocked) {
+    if (++body->incident_stamp==0) {
+        memset(body->incident_seen,0,(size_t)body->ntets*sizeof(uint32_t));
+        body->incident_stamp=1;
+    }
+    double fraction=1;
+    *nblocked=0;
+    for (int j=0;j<count;++j) {
+        const int32_t vertex=nodes[j];
+        for (size_t at=body->incident_off[vertex];at<body->incident_off[vertex+1];++at) {
+            const int32_t t=body->incident_tets[at];
+            if (body->incident_seen[t]==body->incident_stamp) continue;
+            body->incident_seen[t]=body->incident_stamp;
+            double base[4][3],change[4][3]={{0}};
+            for (int k=0;k<4;++k) {
+                const int32_t v=body->tets[4*t+k];
+                memcpy(base[k],body->x+3*v,3*sizeof(double));
+                const int local=contact_local_index(nodes,count,v);
+                if (local>=0) memcpy(change[k],delta[local],3*sizeof(double));
+            }
+            const double limit=guarded_tet_fraction(body,t,base,change,1);
+            fraction=fmin(fraction,limit);
+            if (limit<.999999 && *nblocked<CONTACT_LOCAL_TETS)
+                blocked[(*nblocked)++]=t;
+        }
+    }
+    return fraction;
+}
+
+static int contact_local_normalize(contact_local_row_t *row) {
+    double norm=0;
+    for (int j=0;j<row->count;++j) norm+=dot3(row->gradient[j],row->gradient[j]);
+    norm=sqrt(norm);
+    if (!(norm>1e-30) || !isfinite(norm)) return 0;
+    row->scale=norm;
+    row->rhs/=norm;
+    for (int j=0;j<row->count;++j) for (int k=0;k<3;++k)
+        row->gradient[j][k]/=norm;
+    return isfinite(row->rhs);
+}
+
+lightphysics_status_t lightphysics_deformable_project_contact_guarded(
+    lightphysics_deformable_t *body,const int32_t *vertices,
+    const double *gradients,int32_t count,double depth,
+    int32_t *changed_vertices,int32_t capacity,int32_t *out_count,
+    double *out_multiplier,double *out_fraction) {
+    if (!body || !vertices || !gradients || !changed_vertices || !out_count ||
+        !out_multiplier || !out_fraction || count<1 || count>16 ||
+        capacity<LIGHTPHYSICS_CONTACT_MAX_VERTICES || !isfinite(depth) || depth<0)
+        return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    double denominator=0;
+    for (int j=0;j<count;++j) {
+        if (!valid_index(vertices[j],body->nverts)) return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+        for (int k=0;k<j;++k) if (vertices[k]==vertices[j]) return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+        for (int k=0;k<3;++k) if (!isfinite(gradients[3*j+k])) return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+        denominator+=body->inverse_mass[vertices[j]]*dot3(gradients+3*j,gradients+3*j);
+    }
+    if (!isfinite(denominator)) return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    if (!(denominator>1e-20) || depth==0) {
+        *out_count=0;*out_multiplier=0;*out_fraction=1;
+        return LIGHTPHYSICS_OK;
+    }
+    const double lambda=depth/denominator;
+    if (!isfinite(lambda)) return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    int32_t nodes[LIGHTPHYSICS_CONTACT_MAX_VERTICES],best_nodes[LIGHTPHYSICS_CONTACT_MAX_VERTICES];
+    double delta[LIGHTPHYSICS_CONTACT_MAX_VERTICES][3]={{0}};
+    double best[LIGHTPHYSICS_CONTACT_MAX_VERTICES][3]={{0}};
+    double y[LIGHTPHYSICS_CONTACT_MAX_VERTICES][3]={{0}};
+    for (int j=0;j<count;++j) {
+        nodes[j]=best_nodes[j]=vertices[j];
+        for (int k=0;k<3;++k) {
+            delta[j][k]=body->inverse_mass[vertices[j]]*lambda*gradients[3*j+k];
+            if (!isfinite(body->x[3*vertices[j]+k]+delta[j][k]))
+                return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+        }
+    }
+    lightphysics_status_t status=lightphysics_deformable_prepare_guarded_projection(body);
+    if (status!=LIGHTPHYSICS_OK) return status;
+    int32_t blocked[CONTACT_LOCAL_TETS];int nblocked=0;
+    const double ordinary_fraction=contact_local_fraction(body,nodes,count,delta,blocked,&nblocked);
+    double best_progress=ordinary_fraction*depth,best_multiplier=ordinary_fraction*lambda;
+    int n=count,best_count=count;
+    for (int j=0;j<count;++j) for (int k=0;k<3;++k)
+        best[j][k]=ordinary_fraction*delta[j][k];
+    contact_local_row_t rows[CONTACT_LOCAL_ROWS]={{0}};
+    rows[0].count=count;rows[0].rhs=depth;rows[0].tet=-1;
+    for (int j=0;j<count;++j) {
+        rows[0].local[j]=j;
+        for (int k=0;k<3;++k)
+            rows[0].gradient[j][k]=sqrt(body->inverse_mass[vertices[j]])*gradients[3*j+k];
+    }
+    if (!contact_local_normalize(rows)) return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    int nr=1;
+    /* An unblocked contact remains exactly the ordinary mass projection. */
+    for (int outer=0;ordinary_fraction<.95 && outer<12;++outer) {
+        if (lightphysics_deformable_cancelled(body)) return LIGHTPHYSICS_E_CANCELLED;
+        int added=0;
+        for (int b=0;b<nblocked && nr<CONTACT_LOCAL_ROWS;++b) {
+            const int32_t t=blocked[b];int existing=0;
+            for (int r=1;r<nr;++r) if (rows[r].tet==t) {existing=1;break;}
+            if (existing) continue;
+            contact_local_row_t row={0};row.count=4;row.tet=t;
+            double g[4][3];const int32_t *ids=body->tets+4*t;
+            tetra_gradients(body->x,ids[0],ids[1],ids[2],ids[3],g);
+            const double sign=body->rest_volume[t]>=0 ? 1 : -1;
+            const double current=sign*tetra_volume(body->x,ids[0],ids[1],ids[2],ids[3]);
+            /* Positive reserve keeps curvature from immediately re-locking a
+             * cell already at its floor. It never lowers the configured floor. */
+            row.rhs=fabs(body->rest_volume[t])*(body->options.min_volume_ratio+.01)-current;
+            for (int j=0;j<4;++j) {
+                for (int k=0;k<3;++k)
+                    row.gradient[j][k]=sign*sqrt(body->inverse_mass[ids[j]])*g[j][k];
+            }
+            if (!contact_local_normalize(&row)) continue;
+            int needed=0;
+            for (int j=0;j<4;++j) if (contact_local_index(nodes,n,ids[j])<0) ++needed;
+            if (n+needed>LIGHTPHYSICS_CONTACT_MAX_VERTICES) break;
+            for (int j=0;j<4;++j) {
+                int local=contact_local_index(nodes,n,ids[j]);
+                if (local<0) {local=n;nodes[n++]=ids[j];}
+                row.local[j]=local;
+            }
+            rows[nr++]=row;++added;
+        }
+        if (!added && outer>0) break;
+        memset(y,0,sizeof y);
+        for (int r=0;r<nr;++r) rows[r].multiplier=0;
+        for (int sweep=0;sweep<512;++sweep) {
+            if ((sweep&31)==0 && lightphysics_deformable_cancelled(body)) return LIGHTPHYSICS_E_CANCELLED;
+            double largest=0;
+            for (int r=0;r<nr;++r) {
+                contact_local_row_t *row=rows+r;double value=0;
+                for (int j=0;j<row->count;++j) value+=dot3(row->gradient[j],y[row->local[j]]);
+                const double next=fmax(0,row->multiplier+row->rhs-value);
+                const double dl=next-row->multiplier;row->multiplier=next;
+                largest=fmax(largest,fabs(dl));
+                for (int j=0;j<row->count;++j) for (int k=0;k<3;++k)
+                    y[row->local[j]][k]+=dl*row->gradient[j][k];
+            }
+            if (largest<=1e-10*rows[0].rhs+1e-18) break;
+        }
+        int finite=1;double norm=0;
+        for (int j=0;j<n;++j) for (int k=0;k<3;++k) {
+            delta[j][k]=sqrt(body->inverse_mass[nodes[j]])*y[j][k];
+            if (!isfinite(body->x[3*nodes[j]+k]+delta[j][k])) finite=0;
+            norm+=y[j][k]*y[j][k];
+        }
+        /* Bound the local solve's displacement/energy amplification. */
+        if (!finite || norm>1024*depth*depth/denominator) break;
+        const double fraction=contact_local_fraction(body,nodes,n,delta,blocked,&nblocked);
+        double progress=0;
+        for (int j=0;j<count;++j) progress+=dot3(gradients+3*j,delta[j]);
+        progress*=fraction;
+        if (progress>best_progress+depth*1e-10) {
+            best_progress=progress;best_count=n;
+            best_multiplier=fraction*rows[0].multiplier/rows[0].scale;
+            memcpy(best_nodes,nodes,(size_t)n*sizeof(int32_t));
+            for (int j=0;j<n;++j) for (int k=0;k<3;++k) best[j][k]=fraction*delta[j][k];
+        }
+        if (best_progress>=depth*(1-1e-8) || !nblocked) break;
+    }
+    /* All validation, work budgets, and cancellation precede the mutation. */
+    if (lightphysics_deformable_cancelled(body)) return LIGHTPHYSICS_E_CANCELLED;
+    for (int j=0;j<best_count;++j) for (int k=0;k<3;++k)
+        body->x[3*best_nodes[j]+k]+=best[j][k];
+    body->guard_cache_valid=0;
+    memcpy(changed_vertices,best_nodes,(size_t)best_count*sizeof(int32_t));
+    *out_count=best_count;*out_multiplier=best_multiplier;
+    *out_fraction=fmin(1,fmax(0,best_progress/depth));
+    return LIGHTPHYSICS_OK;
+}
+
+#define COUPLED_LOCAL_ROWS (3 + CONTACT_LOCAL_TETS + 6)
+typedef struct coupled_local_row {
+    int count,local[16];
+    double gradient[16][3],auxiliary[3],rhs,softness,scale;
+    int32_t tet;
+} coupled_local_row_t;
+
+static int coupled_normalize(coupled_local_row_t *row) {
+    double squared=dot3(row->auxiliary,row->auxiliary);
+    for (int j=0;j<row->count;++j) squared+=dot3(row->gradient[j],row->gradient[j]);
+    if (!(squared>1e-60) || !isfinite(squared)) return 0;
+    row->scale=sqrt(squared);row->rhs/=row->scale;row->softness/=squared;
+    for (int j=0;j<row->count;++j) for (int k=0;k<3;++k) row->gradient[j][k]/=row->scale;
+    for (int k=0;k<3;++k) row->auxiliary[k]/=row->scale;
+    return isfinite(row->rhs) && isfinite(row->softness);
+}
+
+static double coupled_row_dot(const coupled_local_row_t *a,const coupled_local_row_t *b) {
+    double value=dot3(a->auxiliary,b->auxiliary);
+    for (int i=0;i<a->count;++i) for (int j=0;j<b->count;++j)
+        if (a->local[i]==b->local[j]) value+=dot3(a->gradient[i],b->gradient[j]);
+    return value;
+}
+
+/* Solve a small positive Gram system on the dual working set. Only rank-
+ * deficient working sets use arithmetic regularization; the subsequent exact
+ * cubic volume guard remains authoritative even for those candidates. */
+static int coupled_working_solve(double h[][COUPLED_LOCAL_ROWS],const double *rhs,
+    const int *index,int n,double *out) {
+    double l[COUPLED_LOCAL_ROWS][COUPLED_LOCAL_ROWS],y[COUPLED_LOCAL_ROWS];
+    const double regularization[3]={0,1e-12,1e-10};
+    for (int attempt=0;attempt<3;++attempt) {
+        int valid=1;
+        for (int i=0;i<n && valid;++i) for (int j=0;j<=i;++j) {
+            double value=h[index[i]][index[j]]+(i==j ? regularization[attempt] : 0);
+            for (int k=0;k<j;++k) value-=l[i][k]*l[j][k];
+            if (i==j) {
+                if (!(value>1e-16) || !isfinite(value)) {valid=0;break;}
+                l[i][j]=sqrt(value);
+            } else l[i][j]=value/l[j][j];
+        }
+        if (!valid) continue;
+        for (int i=0;i<n;++i) {
+            double value=rhs[index[i]];
+            for (int j=0;j<i;++j) value-=l[i][j]*y[j];
+            y[i]=value/l[i][i];
+        }
+        for (int i=n-1;i>=0;--i) {
+            double value=y[i];
+            for (int j=i+1;j<n;++j) value-=l[j][i]*out[index[j]];
+            out[index[i]]=value/l[i][i];
+            if (!isfinite(out[index[i]])) valid=0;
+        }
+        if (valid) return 1;
+    }
+    return 0;
+}
+
+static int coupled_dual_solve(lightphysics_deformable_t *body,
+    coupled_local_row_t *rows,int n,int equality_count,double *multipliers) {
+    double h[COUPLED_LOCAL_ROWS][COUPLED_LOCAL_ROWS],rhs[COUPLED_LOCAL_ROWS];
+    unsigned char active[COUPLED_LOCAL_ROWS]={0};
+    double largest=0;
+    for (int i=0;i<n;++i) {
+        rhs[i]=rows[i].rhs;largest=fmax(largest,fabs(rhs[i]));
+        multipliers[i]=0;active[i]=i<equality_count;
+        for (int j=0;j<=i;++j) {
+            h[i][j]=h[j][i]=coupled_row_dot(rows+i,rows+j)+(i==j ? rows[i].softness : 0);
+        }
+    }
+    const double tolerance=1e-9*largest+1e-18;
+    for (int iteration=0;iteration<256;++iteration) {
+        if ((iteration&15)==0 && lightphysics_deformable_cancelled(body)) return 0;
+        int index[COUPLED_LOCAL_ROWS],count=0;
+        for (int i=0;i<n;++i) if (active[i]) index[count++]=i;
+        double candidate[COUPLED_LOCAL_ROWS]={0};
+        if (!coupled_working_solve(h,rhs,index,count,candidate)) return 0;
+        double fraction=1;
+        int drop=-1;
+        for (int i=equality_count;i<n;++i) if (active[i] && candidate[i]<0) {
+            const double limit=multipliers[i]/(multipliers[i]-candidate[i]);
+            if (limit<=fraction) {fraction=limit;drop=i;}
+        }
+        for (int i=0;i<n;++i) {
+            multipliers[i]+=fraction*(candidate[i]-multipliers[i]);
+            if (i>=equality_count) multipliers[i]=fmax(0,multipliers[i]);
+        }
+        if (drop>=0) {active[drop]=0;multipliers[drop]=0;continue;}
+        int add=-1;double minimum=-tolerance;
+        for (int i=equality_count;i<n;++i) if (!active[i]) {
+            double gradient=-rhs[i];
+            for (int j=0;j<n;++j) gradient+=h[i][j]*multipliers[j];
+            if (gradient<minimum) {minimum=gradient;add=i;}
+        }
+        if (add<0) return 1;
+        active[add]=1;
+    }
+    return 0;
+}
+
+static int coupled_add_bounds(coupled_local_row_t *rows,int *nr,const double inverse[3],
+    const double q[3],const double lower[3],const double upper[3]) {
+    for (int k=0;k<3;++k) if (inverse[k]>0) for (int side=0;side<2;++side) {
+        coupled_local_row_t row={0};row.tet=-1;
+        row.auxiliary[k]=(side ? -1 : 1)*sqrt(inverse[k]);
+        row.rhs=side ? q[k]-upper[k] : lower[k]-q[k];
+        if (!coupled_normalize(&row)) return 0;
+        rows[(*nr)++]=row;
+    }
+    return 1;
+}
+
+static lightphysics_status_t coupled_project_local(lightphysics_deformable_t *body,
+    coupled_local_row_t *rows,int nr,int constraint_count,int equality_count,
+    const int32_t *initial_nodes,int initial_count,const double inverse_inertia[3],
+    const double q[3],const double lower[3],const double upper[3],double reserve,
+    const double previous_multipliers[3],
+    int32_t *changed_vertices,int32_t *out_count,double increments[3],double delta_q[3],double *out_fraction) {
+    double root_aux[3],norm_rhs=0;
+    for (int k=0;k<3;++k) root_aux[k]=sqrt(inverse_inertia[k]);
+    for (int k=0;k<constraint_count;++k) {
+        const double rhs=rows[k].rhs*rows[k].scale;norm_rhs+=rhs*rhs;
+    }
+    norm_rhs=sqrt(norm_rhs);
+    if (!isfinite(norm_rhs)) return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    if (!norm_rhs) {
+        if (lightphysics_deformable_cancelled(body)) return LIGHTPHYSICS_E_CANCELLED;
+        memset(delta_q,0,3*sizeof(double));memset(increments,0,3*sizeof(double));
+        *out_count=0;*out_fraction=1;return LIGHTPHYSICS_OK;
+    }
+    int32_t nodes[LIGHTPHYSICS_CONTACT_MAX_VERTICES],best_nodes[LIGHTPHYSICS_CONTACT_MAX_VERTICES];
+    memcpy(nodes,initial_nodes,(size_t)initial_count*sizeof(int32_t));
+    double best[LIGHTPHYSICS_CONTACT_MAX_VERTICES][3]={{0}},best_q[3]={0},best_lambda[3]={0};
+    double best_progress=0,trust=32*norm_rhs;
+    int n=initial_count,best_count=0;
+    for (int outer=0;outer<12;++outer) {
+        if (lightphysics_deformable_cancelled(body)) return LIGHTPHYSICS_E_CANCELLED;
+        double multiplier[COUPLED_LOCAL_ROWS];
+        if (!coupled_dual_solve(body,rows,nr,equality_count,multiplier)) break;
+        double y[LIGHTPHYSICS_CONTACT_MAX_VERTICES][3]={{0}},yq[3]={0};
+        for (int r=0;r<nr;++r) {
+            for (int j=0;j<rows[r].count;++j) for (int k=0;k<3;++k)
+                y[rows[r].local[j]][k]+=multiplier[r]*rows[r].gradient[j][k];
+            for (int k=0;k<3;++k) yq[k]+=multiplier[r]*rows[r].auxiliary[k];
+        }
+        double change[LIGHTPHYSICS_CONTACT_MAX_VERTICES][3],dq[3],dl[3];int finite=1;
+        for (int j=0;j<n;++j) for (int k=0;k<3;++k) {
+            change[j][k]=sqrt(body->inverse_mass[nodes[j]])*y[j][k];
+            if (!isfinite(body->x[3*nodes[j]+k]+change[j][k])) finite=0;
+        }
+        for (int k=0;k<3;++k) {
+            dq[k]=root_aux[k]*yq[k];dl[k]=k<constraint_count ? multiplier[k]/rows[k].scale : 0;
+            if (!isfinite(dq[k]) || !isfinite(dl[k]) || !isfinite(previous_multipliers[k]+dl[k])) finite=0;
+            /* Remove only arithmetic noise in a solved active joint bound. */
+            const double endpoint=q[k]+dq[k];
+            if (endpoint<lower[k] && lower[k]-endpoint<=1e-12*(1+fabs(lower[k]))) dq[k]=lower[k]-q[k];
+            if (endpoint>upper[k] && endpoint-upper[k]<=1e-12*(1+fabs(upper[k]))) dq[k]=upper[k]-q[k];
+        }
+        if (!finite) break;
+        int32_t blocked[CONTACT_LOCAL_TETS];int nblocked=0;
+        double fraction=contact_local_fraction(body,nodes,n,change,blocked,&nblocked);
+        for (int k=0;k<3;++k) {
+            if (dq[k]>0) fraction=fmin(fraction,(upper[k]-q[k])/dq[k]);
+            if (dq[k]<0) fraction=fmin(fraction,(lower[k]-q[k])/dq[k]);
+        }
+        fraction=fmax(0,fmin(1,fraction));
+        double error=0;
+        for (int k=0;k<constraint_count;++k) {
+            double value=rows[k].softness*multiplier[k];
+            for (int j=0;j<rows[k].count;++j) value+=dot3(rows[k].gradient[j],y[rows[k].local[j]]);
+            for (int j=0;j<3;++j) if (root_aux[j]>0) value+=rows[k].auxiliary[j]*dq[j]/root_aux[j];
+            double difference=rows[k].scale*(rows[k].rhs-fraction*value);
+            if (k>=equality_count) difference=fmax(0,difference);
+            error+=difference*difference;
+        }
+        const double progress=1-sqrt(error)/norm_rhs;
+        int bounded=1;
+        for (int j=0;j<n;++j) if (fraction*norm3(change[j])>fmax(trust,1e-15)) bounded=0;
+        if (bounded && progress>best_progress) {
+            best_progress=progress;best_count=n;
+            memcpy(best_nodes,nodes,(size_t)n*sizeof(int32_t));
+            for (int j=0;j<n;++j) for (int k=0;k<3;++k) best[j][k]=fraction*change[j][k];
+            for (int k=0;k<3;++k) {best_q[k]=fraction*dq[k];best_lambda[k]=fraction*dl[k];}
+        }
+        if (best_progress>=1-1e-8 || !nblocked) break;
+        int added=0;
+        for (int b=0;b<nblocked && nr<COUPLED_LOCAL_ROWS;++b) {
+            const int32_t t=blocked[b];int exists=0;
+            for (int r=constraint_count;r<nr;++r) if (rows[r].tet==t) {exists=1;break;}
+            if (exists) continue;
+            const int32_t *ids=body->tets+4*t;double gradient[4][3];
+            tetra_gradients(body->x,ids[0],ids[1],ids[2],ids[3],gradient);
+            coupled_local_row_t row={0};row.count=4;row.tet=t;
+            const double sign=body->rest_volume[t]>=0 ? 1 : -1;
+            const double current=sign*tetra_volume(body->x,ids[0],ids[1],ids[2],ids[3]);
+            row.rhs=fabs(body->rest_volume[t])*(body->options.min_volume_ratio+reserve)-current;
+            for (int j=0;j<4;++j) {
+                for (int k=0;k<3;++k) row.gradient[j][k]=sign*sqrt(body->inverse_mass[ids[j]])*gradient[j][k];
+                for (int k=0;k<j;++k) {
+                    double edge[3];sub3(body->x+3*ids[j],body->x+3*ids[k],edge);trust=fmax(trust,.05*norm3(edge));
+                }
+            }
+            if (!coupled_normalize(&row)) continue;
+            int needed=0;
+            for (int j=0;j<4;++j) if (contact_local_index(nodes,n,ids[j])<0) ++needed;
+            if (n+needed>LIGHTPHYSICS_CONTACT_MAX_VERTICES) break;
+            for (int j=0;j<4;++j) {
+                int local=contact_local_index(nodes,n,ids[j]);
+                if (local<0) {local=n;nodes[n++]=ids[j];}
+                row.local[j]=local;
+            }
+            rows[nr++]=row;++added;
+        }
+        if (!added) break;
+    }
+    if (lightphysics_deformable_cancelled(body)) return LIGHTPHYSICS_E_CANCELLED;
+    for (int j=0;j<best_count;++j) for (int k=0;k<3;++k) body->x[3*best_nodes[j]+k]+=best[j][k];
+    for (int k=0;k<3;++k) {delta_q[k]=best_q[k];increments[k]=best_lambda[k];}
+    memcpy(changed_vertices,best_nodes,(size_t)best_count*sizeof(int32_t));*out_count=best_count;
+    body->guard_cache_valid=0;*out_fraction=fmax(0,fmin(1,best_progress));
+    return LIGHTPHYSICS_OK;
+}
+
+static void rescue_volume_constraint(lightphysics_deformable_t *body,int32_t tet,double alpha) {
+    const int32_t *ids=body->tets+4*tet;
+    double gradient[4][3];tetra_gradients(body->x,ids[0],ids[1],ids[2],ids[3],gradient);
+    double area=0;for (int j=0;j<4;++j) area+=dot3(gradient[j],gradient[j]);
+    area=sqrt(area);
+    if (!(area>1e-30) || !isfinite(area)) return;
+    const double residual=body->rest_volume[tet]-tetra_volume(body->x,ids[0],ids[1],ids[2],ids[3]);
+    coupled_local_row_t rows[COUPLED_LOCAL_ROWS]={{0}};
+    rows[0].count=4;rows[0].tet=-1;
+    rows[0].rhs=(residual-alpha*body->lambda_volume[tet])/area;
+    rows[0].softness=alpha/(area*area);
+    for (int j=0;j<4;++j) {
+        rows[0].local[j]=j;
+        for (int k=0;k<3;++k) rows[0].gradient[j][k]=sqrt(body->inverse_mass[ids[j]])*gradient[j][k]/area;
+    }
+    if (!coupled_normalize(rows)) return;
+    const double zero[3]={0},lower[3]={-1,-1,-1},upper[3]={1,1,1};
+    const double previous[3]={body->lambda_volume[tet]*area,0,0};
+    int32_t changed[LIGHTPHYSICS_CONTACT_MAX_VERTICES],count;
+    double increments[3],dq[3],fraction;
+    lightphysics_status_t status=coupled_project_local(body,rows,1,1,1,ids,4,zero,zero,lower,upper,.001,
+        previous,changed,&count,increments,dq,&fraction);
+    if (status==LIGHTPHYSICS_OK) body->lambda_volume[tet]+=increments[0]/area;
+}
+
+lightphysics_status_t lightphysics_deformable_project_coupled_attachment_guarded(
+    lightphysics_deformable_t *body,int32_t vertex,const double residual[3],
+    const double jacobian[9],const double inverse_inertia[3],const double q[3],
+    const double lower[3],const double upper[3],double alpha,double lambda[3],
+    double delta_q[3],double *out_fraction) {
+    if (!body || !residual || !jacobian || !inverse_inertia || !q || !lower || !upper ||
+        !lambda || !delta_q || !out_fraction || !valid_index(vertex,body->nverts) ||
+        !(body->inverse_mass[vertex]>0) || !isfinite(alpha) || alpha<0)
+        return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    double rhs[3],norm_rhs=0;
+    for (int k=0;k<3;++k) {
+        if (!isfinite(residual[k]) || !isfinite(inverse_inertia[k]) || inverse_inertia[k]<0 ||
+            !isfinite(q[k]) || !isfinite(lower[k]) || !isfinite(upper[k]) ||
+            lower[k]>upper[k] || q[k]<lower[k] || q[k]>upper[k] || !isfinite(lambda[k]))
+            return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+        rhs[k]=residual[k]-alpha*lambda[k];
+        if (!isfinite(rhs[k])) return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+        norm_rhs+=rhs[k]*rhs[k];
+        for (int j=0;j<3;++j) if (!isfinite(jacobian[3*k+j])) return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    }
+    norm_rhs=sqrt(norm_rhs);
+    if (!isfinite(norm_rhs)) return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    if (!norm_rhs) {
+        if (lightphysics_deformable_cancelled(body)) return LIGHTPHYSICS_E_CANCELLED;
+        memset(delta_q,0,3*sizeof(double));*out_fraction=1;return LIGHTPHYSICS_OK;
+    }
+    lightphysics_status_t status=lightphysics_deformable_prepare_guarded_projection(body);
+    if (status!=LIGHTPHYSICS_OK) return status;
+    coupled_local_row_t rows[COUPLED_LOCAL_ROWS]={{0}};
+    const double root_mass=sqrt(body->inverse_mass[vertex]);
+    double root_aux[3];for (int k=0;k<3;++k) root_aux[k]=sqrt(inverse_inertia[k]);
+    for (int k=0;k<3;++k) {
+        rows[k].count=1;rows[k].local[0]=0;rows[k].gradient[0][k]=root_mass;
+        rows[k].rhs=rhs[k];rows[k].softness=alpha;rows[k].tet=-1;
+        for (int j=0;j<3;++j) rows[k].auxiliary[j]=-root_aux[j]*jacobian[3*k+j];
+        if (!coupled_normalize(rows+k)) return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    }
+    int nr=3;
+    if (!coupled_add_bounds(rows,&nr,inverse_inertia,q,lower,upper)) return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    int32_t changed[LIGHTPHYSICS_CONTACT_MAX_VERTICES],changed_count;
+    double increments[3];
+    status=coupled_project_local(body,rows,nr,3,3,&vertex,1,inverse_inertia,q,lower,upper,.001,
+        lambda,changed,&changed_count,increments,delta_q,out_fraction);
+    if (status==LIGHTPHYSICS_OK) for (int k=0;k<3;++k) lambda[k]+=increments[k];
+    return status;
+}
+
+lightphysics_status_t lightphysics_deformable_project_coupled_contact_guarded(
+    lightphysics_deformable_t *body,const int32_t *vertices,const double *gradients,
+    int32_t count,double depth,const double generalized_gradient[3],
+    const double inverse_inertia[3],const double q[3],const double lower[3],const double upper[3],
+    int32_t *changed_vertices,int32_t capacity,int32_t *out_count,
+    double *out_multiplier,double delta_q[3],double *out_fraction) {
+    if (!body || !vertices || !gradients || !generalized_gradient || !inverse_inertia ||
+        !q || !lower || !upper || !changed_vertices || !out_count || !out_multiplier ||
+        !delta_q || !out_fraction || count<1 || count>16 || count>body->nverts ||
+        capacity<LIGHTPHYSICS_CONTACT_MAX_VERTICES || !isfinite(depth) || depth<0)
+        return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    for (int j=0;j<count;++j) {
+        if (!valid_index(vertices[j],body->nverts)) return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+        for (int k=0;k<j;++k) if (vertices[j]==vertices[k]) return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+        for (int k=0;k<3;++k) if (!isfinite(gradients[3*j+k])) return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    }
+    for (int k=0;k<3;++k) if (!isfinite(generalized_gradient[k]) || !isfinite(inverse_inertia[k]) || inverse_inertia[k]<0 ||
+        !isfinite(q[k]) || !isfinite(lower[k]) || !isfinite(upper[k]) ||
+        lower[k]>upper[k] || q[k]<lower[k] || q[k]>upper[k]) return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    coupled_local_row_t rows[COUPLED_LOCAL_ROWS]={{0}};
+    rows[0].count=count;rows[0].rhs=depth;rows[0].tet=-1;
+    for (int j=0;j<count;++j) {
+        rows[0].local[j]=j;
+        for (int k=0;k<3;++k) rows[0].gradient[j][k]=sqrt(body->inverse_mass[vertices[j]])*gradients[3*j+k];
+    }
+    for (int k=0;k<3;++k) rows[0].auxiliary[k]=sqrt(inverse_inertia[k])*generalized_gradient[k];
+    if (!coupled_normalize(rows)) {
+        /* A valid fully immobile pair has no projection or paired impulse. */
+        double magnitude=0;
+        for (int j=0;j<count;++j) magnitude+=body->inverse_mass[vertices[j]]*dot3(gradients+3*j,gradients+3*j);
+        for (int k=0;k<3;++k) magnitude+=inverse_inertia[k]*generalized_gradient[k]*generalized_gradient[k];
+        if (!isfinite(magnitude) || magnitude>1e-60) return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+        if (lightphysics_deformable_cancelled(body)) return LIGHTPHYSICS_E_CANCELLED;
+        *out_count=0;*out_multiplier=0;memset(delta_q,0,3*sizeof(double));*out_fraction=depth>0 ? 0 : 1;
+        return LIGHTPHYSICS_OK;
+    }
+    int nr=1;
+    if (!coupled_add_bounds(rows,&nr,inverse_inertia,q,lower,upper)) return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    lightphysics_status_t status=lightphysics_deformable_prepare_guarded_projection(body);
+    if (status!=LIGHTPHYSICS_OK) return status;
+    const double previous[3]={0};double increments[3];
+    status=coupled_project_local(body,rows,nr,1,0,vertices,count,inverse_inertia,q,lower,upper,.01,
+        previous,changed_vertices,out_count,increments,delta_q,out_fraction);
+    if (status==LIGHTPHYSICS_OK) *out_multiplier=increments[0];
+    return status;
+}
+
+lightphysics_status_t lightphysics_deformable_read_inertial_guard_fractions(
+    const lightphysics_deformable_t *body,const int32_t *vertices,int32_t count,
+    double *out,int32_t capacity) {
+    if (!body || !vertices || !out || count<1 || count>body->nverts || capacity<count)
+        return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    for (int j=0;j<count;++j) if (!valid_index(vertices[j],body->nverts)) return LIGHTPHYSICS_E_INVALID_ARGUMENT;
+    if (!body->guard_prediction_valid || !body->guard_component) return LIGHTPHYSICS_E_INVALID_STATE;
+    for (int j=0;j<count;++j) {
+        const int32_t component=body->guard_component[vertices[j]];
+        out[j]=component<0 ? 1 : body->guard_components[component].fraction;
+    }
+    return LIGHTPHYSICS_OK;
+}
