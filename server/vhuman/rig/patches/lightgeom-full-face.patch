+void lightphysics_surface_contact_destroy(lightphysics_surface_contact_t *c){if(!c)return;free(c->faces);free(c->edges);free(c->forder);free(c->eorder);free(c->surface);free(c->rest);free(c->mass);free(c->ftree);free(c->etree);free(c);}
