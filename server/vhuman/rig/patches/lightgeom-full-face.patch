+static void refresh_guard_bounds(lightphysics_deformable_t *body) {
+    memcpy(body->guard_reference,body->x,(size_t)body->nverts*3*sizeof(double));
+    memset(body->guard_invalid,0,(size_t)body->nverts);
+    for (int32_t v=0;v<body->nverts;++v) body->guard_radius[v]=DBL_MAX;
+    body->guard_cache_valid=1;
+    for (int32_t t=0;t<body->ntets;++t) {
+        const int32_t *ids=body->tets+4*t;
+        const double sign=body->rest_volume[t]>=0 ? 1 : -1;
+        const double current=sign*tetra_volume(body->x,ids[0],ids[1],ids[2],ids[3]);
+        if (!(current>0) || !isfinite(current)) {body->guard_cache_valid=0;return;}
+        const double floor=fmin(fabs(body->rest_volume[t])*body->options.min_volume_ratio,current*(1-1e-10));
+        double edge[3][3],length[3];
+        for (int j=0;j<3;++j) {
+            sub3(body->x+3*ids[j+1],body->x+3*ids[0],edge[j]);
+            length[j]=norm3(edge[j]);
+        }
+        /* If every vertex stays in a ball of radius r, each edge changes by
+         * at most 2r. Multilinearity bounds the determinant change by
+         * L*r + Q*r^2 + 8*r^3. For r<=r0 this is <=r*(L+Q*r0+8*r0^2).
+         * Balls are convex, so the entire correction path is covered. */
+        const double r0=(length[0]+length[1]+length[2])/6;
+        const double linear=2*(length[0]*length[1]+length[0]*length[2]+length[1]*length[2]);
+        const double quadratic=4*(length[0]+length[1]+length[2]);
+        const double denominator=linear+quadratic*r0+8*r0*r0;
+        const double radius=denominator>0 ? .99*fmin(r0,6*(current-floor)/denominator) : 0;
+        for (int j=0;j<4;++j)
+            body->guard_radius[ids[j]]=fmin(body->guard_radius[ids[j]],radius);
+    }
+}
+
+static double triple_product(const double a[3],const double b[3],const double c[3]) {
+    double cross[3]; cross3(b,c,cross); return dot3(a,cross);
+}
+
+static double cubic_value(const double c[4],double t) {
+    return ((c[3]*t+c[2])*t+c[1])*t+c[0];
+}
+
+/* Check the entire interval, including interior extrema. Checking just its
+ * endpoint misses a tetrahedron that inverts and then becomes positive. */
+static int cubic_admissible(const double c[4],double end) {
+    if (cubic_value(c,end)<0) return 0;
+    const double a=3*c[3],b=2*c[2],d=c[1];
+    if (fabs(a)<1e-30) {
+        if (fabs(b)>1e-30) {
+            double root=-d/b;
+            if (root>0 && root<end && cubic_value(c,root)<0) return 0;
+        }
+    } else {
+        const double disc=b*b-4*a*d;
+        if (disc>=0) {
+            /* Stable quadratic roots, including a zero constant term. */
+            const double q=-.5*(b+copysign(sqrt(disc),b));
+            const double roots[2]={q/a,q!=0 ? d/q : -b/(2*a)};
+            for (int k=0;k<2;++k)
+                if (roots[k]>0 && roots[k]<end && cubic_value(c,roots[k])<0) return 0;
+        }
+    }
+    return 1;
+}
