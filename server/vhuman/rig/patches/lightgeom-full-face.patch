+static lightphysics_status_t prepare_guard_components(lightphysics_deformable_t *body) {
+    if (body->guard_component) return LIGHTPHYSICS_OK;
+    int32_t *parent=malloc((size_t)body->nverts*sizeof *parent);
+    int32_t *mapping=malloc((size_t)body->nverts*sizeof *mapping);
+    int32_t *component=malloc((size_t)body->nverts*sizeof *component);
+    if (!parent || !mapping || !component) {
+        free(parent);free(mapping);free(component);return LIGHTPHYSICS_E_OUT_OF_MEMORY;
+    }
+    for (int32_t v=0;v<body->nverts;++v) {parent[v]=v;mapping[v]=-1;}
+    for (int32_t t=0;t<body->ntets;++t) {
+        const int32_t *ids=body->tets+4*t;
+        for (int j=1;j<4;++j) {
+            int32_t a=guard_component_root(parent,ids[0]),b=guard_component_root(parent,ids[j]);
+            if (a!=b) parent[a>b ? a : b]=a<b ? a : b;
+        }
+    }
+    int32_t count=0;
+    for (int32_t v=0;v<body->nverts;++v) {
+        component[v]=-1;
+        if (body->incident_off[v+1]==body->incident_off[v]) continue;
+        const int32_t root=guard_component_root(parent,v);
+        if (mapping[root]<0) mapping[root]=count++;
+        component[v]=mapping[root];
+    }
+    deformable_guard_component_t *records=calloc((size_t)count+1,sizeof *records);
+    free(parent);free(mapping);
+    if (!records) {free(component);return LIGHTPHYSICS_E_OUT_OF_MEMORY;}
+    body->guard_component=component;body->guard_component_count=count;body->guard_components=records;
+    return LIGHTPHYSICS_OK;
+}
