+    for(int j=0;j<4;++j)for(int k=0;k<3;++k){
+        double impulse=lambda*w[j]*n[k]/dt;
+        x[3*id[j]+k]+=c->mass[id[j]]*lambda*w[j]*n[k];
+        if(reaction)reaction[3*id[j]+k]+=impulse;
+    }
+}
+static int build_tree(node_t *tree,int *count,int32_t *order,int begin,int end,
+                      const int32_t *ids,int arity,const double *old,const double *x,double h) {
