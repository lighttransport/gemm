+        lightphysics_deformable_desc_t desc={0};desc.nverts=4;desc.rest_positions=rest;desc.inverse_mass=mass;desc.ntets=1;desc.tets=tet;
+        lightphysics_deformable_options_t options;lightphysics_deformable_options_default(&options);options.min_volume_ratio=.06f;
+        lightphysics_deformable_t *body=NULL;
