+static void test_anisotropic_attachments(void) {
+    const float rest[3]={0,0,0},mass[1]={2};
+    lightphysics_deformable_desc_t desc;
+    memset(&desc,0,sizeof desc);
+    desc.nverts=1;desc.rest_positions=rest;desc.inverse_mass=mass;
+    lightphysics_deformable_options_t options;
+    lightphysics_deformable_options_default(&options);
+    options.substeps=options.iterations=1;options.damping=1;
+    options.gravity[0]=options.gravity[1]=options.gravity[2]=0;
+    const lightphysics_deformable_attachment_t base_attachment={0,{.01f,.02f,.03f},1,0};
+    const double normals[2][3]={{0,0,2},{1,1,1}},compliance[1]={2};
+    for (int variant=0;variant<8;++variant) {
+        const int guarded=variant/4;
+        lightphysics_deformable_attachment_t attachment=base_attachment;
+        attachment.weight=variant%4<2?1.f:.5f;
+        const double *normal=normals[variant%2];
+        lightphysics_deformable_t *body=NULL;
+        CHECK(lightphysics_deformable_create(&desc,&options,&body)==LIGHTPHYSICS_OK,"anisotropic body create failed");
+        if (!body) continue;
+        CHECK(lightphysics_deformable_set_attachments(body,&attachment,1)==LIGHTPHYSICS_OK,"anisotropic attachment create failed");
+        CHECK(lightphysics_deformable_set_attachment_frames(body,normal,compliance,1)==LIGHTPHYSICS_OK,"attachment frames failed");
+        double invalid[3]={NAN,0,1};
+        CHECK(lightphysics_deformable_set_attachment_frames(body,invalid,compliance,1)==LIGHTPHYSICS_E_INVALID_ARGUMENT,"invalid normal accepted");
+        CHECK(lightphysics_deformable_set_attachment_frames(body,normal,compliance,0)==LIGHTPHYSICS_E_INVALID_ARGUMENT,"invalid frame count accepted");
+        CHECK(lightphysics_deformable_set_attachment_frames(body,NULL,compliance,1)==LIGHTPHYSICS_E_INVALID_ARGUMENT,"incomplete frame accepted");
+        CHECK(lightphysics_deformable_enable_guarded_solve(body,guarded)==LIGHTPHYSICS_OK,"anisotropic guard enable failed");
+        float result[3];double lambda[3];
+        CHECK(lightphysics_deformable_step(body,NULL,.01,result)==LIGHTPHYSICS_OK,"anisotropic step failed");
+        const double w=2*attachment.weight;
+        const double fraction=w*.01*.01/(w*.01*.01+2);
+        double projected=0,length2=0;
+        for (int k=0;k<3;++k) { projected+=attachment.target[k]*normal[k];length2+=normal[k]*normal[k]; }
+        for (int k=0;k<3;++k) {
+            const double support=projected*normal[k]/length2;
+            const double expected=support+(attachment.target[k]-support)*fraction;
+            CHECK(fabs(result[k]-expected)<1e-8,"rotated anisotropic attachment disagrees with analytic XPBD");
+        }
+        CHECK(lightphysics_deformable_read_attachment_impulses(body,lambda,3)==LIGHTPHYSICS_OK,"read attachment multipliers failed");
+        for (int k=0;k<3;++k) CHECK(fabs(w*lambda[k]-result[k])<1e-8,"attachment multiplier units disagree with momentum");
+        CHECK(lightphysics_deformable_set_attachment_frames(body,NULL,NULL,1)==LIGHTPHYSICS_OK,"frame reset failed");
+        CHECK(lightphysics_deformable_step(body,NULL,.01,result)==LIGHTPHYSICS_OK,"isotropic reset step failed");
+        for (int k=0;k<3;++k) CHECK(fabs(result[k]-attachment.target[k])<1e-8,"frame reset did not restore isotropic behavior");
+        lightphysics_deformable_destroy(body);
+    }
+}
