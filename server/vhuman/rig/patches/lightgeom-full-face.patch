+static void test_independent_inertial_components(void) {
+    const float rest[27]={0,0,0, 1,0,0, 0,1,0, 0,0,1,
+                         3,0,0, 4,0,0, 3,1,0, 3,0,1, 6,0,0};
+    const int32_t tets[8]={0,1,2,3,4,5,6,7};
+    for (int pinned=0;pinned<2;++pinned) {
+        float velocity[27]={0},mass[9],result[27];
+        for (int i=0;i<9;++i) mass[i]=1;
+        if (pinned) mass[0]=0;
+        for (int i=0;i<4;++i) for (int c=0;c<2;++c)
+            velocity[3*i+c]=-200*(rest[3*i+c]-.25f);
+        for (int i=4;i<8;++i) {velocity[3*i]=1;velocity[3*i+1]=2;velocity[3*i+2]=3;}
+        velocity[24]=4;velocity[25]=5;velocity[26]=6;
+        lightphysics_deformable_desc_t desc={0};
+        desc.nverts=9;desc.rest_positions=rest;desc.ntets=2;desc.tets=tets;
+        desc.inverse_mass=mass;desc.initial_velocities=velocity;
+        lightphysics_deformable_options_t options;
+        lightphysics_deformable_options_default(&options);
+        options.substeps=1;options.iterations=1;options.damping=1;options.min_volume_ratio=.06f;
+        options.volume_compliance=0;options.gravity[0]=options.gravity[1]=options.gravity[2]=0;
+        lightphysics_deformable_t *body=NULL;
+        CHECK(lightphysics_deformable_create(&desc,&options,&body)==LIGHTPHYSICS_OK,"component body create failed");
+        if (!body) continue;
+        CHECK(lightphysics_deformable_enable_guarded_solve(body,1)==LIGHTPHYSICS_OK,"component guard enable failed");
+        CHECK(lightphysics_deformable_step(body,NULL,.01,result)==LIGHTPHYSICS_OK,"component step failed");
+        for (int i=4;i<8;++i) for (int c=0;c<3;++c)
+            CHECK(fabs(result[3*i+c]-(rest[3*i+c]+.01*(c+1)))<1e-6,
+                  "unrelated tet motion was limited by another component");
+        for (int c=0;c<3;++c)
+            CHECK(fabs(result[24+c]-(rest[24+c]+.01*(c+4)))<1e-6,
+                  "isolated particle motion was limited by a tet");
+        CHECK(volume(result)>.049999/6,"component volume guard failed");
+        lightphysics_deformable_destroy(body);
+    }
+}
