"/* One-token combine + sigmoid gate + native Q8_1 for the output projection:\n"
" * the combine above, then sigmoid_mul_q81_f32 of the fast-math main module\n"
" * reproduced op for op (range-reduced v_exp, v_rcp, refined Q8_1 divides,\n"
" * f16 scale round trip).  Also runs when the split count is one. */\n"
"__device__ __forceinline__ float q8_gate_recip(float b) {\n"
"    float r, e, nb = -b;\n"
"    asm volatile(\"v_rcp_f32 %0, %1\" : \"=v\"(r) : \"v\"(b));\n"
"    asm volatile(\"v_fma_f32 %0, %1, %2, 1.0\" : \"=v\"(e) : \"v\"(nb), \"v\"(r));\n"
"    asm volatile(\"v_fma_f32 %0, %1, %2, %3\" : \"=v\"(r) : \"v\"(e), \"v\"(r), \"v\"(r));\n"
"    asm volatile(\"v_fma_f32 %0, %1, %2, 1.0\" : \"=v\"(e) : \"v\"(nb), \"v\"(r));\n"
"    asm volatile(\"v_fma_f32 %0, %1, %2, %3\" : \"=v\"(r) : \"v\"(e), \"v\"(r), \"v\"(r));\n"
"    return r;\n"
"}\n"
"__device__ __forceinline__ float q8_gate_div(float a, float b) {\n"
"    float r = q8_gate_recip(b), q, e, nb = -b;\n"
"    asm volatile(\"v_mul_f32 %0, %1, %2\" : \"=v\"(q) : \"v\"(a), \"v\"(r));\n"
"    asm volatile(\"v_fma_f32 %0, %1, %2, %3\" : \"=v\"(e) : \"v\"(nb), \"v\"(q), \"v\"(a));\n"
"    asm volatile(\"v_fma_f32 %0, %1, %2, %3\" : \"=v\"(q) : \"v\"(e), \"v\"(r), \"v\"(q));\n"
"    return q;\n"
"}\n"
"extern \"C\" __global__ __launch_bounds__(256, 1)\n"
"void qwen35_attention_q8_combine_gate_q81(float *out, const float *parts,\n"
"        const float2 *meta, const float *gate, const int *position,\n"
"        int heads, int nsm, int occupancy, int forced_splits,\n"
"        signed char *q, float *qscale) {\n"
"    int tid = threadIdx.x;\n"
"    int splits = forced_splits ? forced_splits :\n"
"        q8_gate_splits(position[0] + 1, heads, nsm, occupancy);\n"
"    int head = blockIdx.x;\n"
"    float value;\n"
"    if (splits == 1) {\n"
"        value = out[head * 256 + tid];\n"
"    } else {\n"
"        parts += head * splits * 256; meta += head * splits;\n"
"        extern __shared__ float2 shared_meta[];\n"
"        for (int i = tid; i < 2 * splits; i += 256)\n"
"            ((float *)shared_meta)[i] = ((const float *)meta)[i];\n"
"        __syncthreads();\n"
"        float maximum = shared_meta[0].x;\n"
"        for (int i = 1; i < splits; ++i) maximum = fmaxf(maximum, shared_meta[i].x);\n"
"        float numerator = 0.0f, denominator = 0.0f;\n"
"        for (int i = 0; i < splits; ++i) {\n"
"            float scale = expf(shared_meta[i].x - maximum);\n"
"            numerator += scale * parts[i * 256 + tid];\n"
"            denominator += scale * shared_meta[i].y;\n"
"        }\n"
"        value = numerator / denominator;\n"
"    }\n"
"    int i = head * 256 + tid;\n"
"    float g = gate[i], e, v;\n"
"    bool big = g > __uint_as_float(0x42aeac50u);\n"
"    float t = g;\n"
"    if (big) asm volatile(\"v_add_f32 %0, 0xc2800000, %1\" : \"=v\"(t) : \"v\"(g));\n"
"    asm volatile(\"v_mul_f32 %0, 0xbfb8aa3b, %1\" : \"=v\"(e) : \"v\"(t));\n"
"    asm volatile(\"v_exp_f32 %0, %1\" : \"=v\"(e) : \"v\"(e));\n"
"    if (big) asm volatile(\"v_mul_f32 %0, 0x114b4ea4, %1\" : \"=v\"(e) : \"v\"(e));\n"
"    asm volatile(\"v_add_f32 %0, 1.0, %1\" : \"=v\"(e) : \"v\"(e));\n"
"    asm volatile(\"v_rcp_f32 %0, %1\" : \"=v\"(e) : \"v\"(e));\n"
"    asm volatile(\"v_mul_f32 %0, %1, %2\" : \"=v\"(v) : \"v\"(e), \"v\"(value));\n"
"    out[i] = v;\n"
"    float a = fabsf(v);\n"
"    for (int off = 16; off; off >>= 1) a = fmaxf(a, __shfl_xor(a, off, 32));\n"
"    float d = q8_gate_div(a, 127.0f);\n"
"    q[i] = a == 0.0f ? 0 : (signed char)roundf(q8_gate_div(v, d));\n"
"    if ((tid & 31) == 0) {\n"
"        unsigned int h; float y;\n"
"        asm volatile(\"v_cvt_f16_f32 %0, %1\" : \"=v\"(h) : \"v\"(d));\n"
"        asm volatile(\"v_cvt_f32_f16 %0, %1\" : \"=v\"(y) : \"v\"(h));\n"
"        qscale[i >> 5] = y;\n"
"    }\n"
"}\n";
