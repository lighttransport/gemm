"    __syncthreads();\n"
"    for (int q = 0; q < 4; ++q) {\n"
"        int query = q0 + q;\n"
"        int splits = split_count[q];\n"
"        float value;\n"
"        if (splits == 1) value = out[((size_t)query * heads + head) * 256 + tid];\n"
"        else if (splits > 1) {\n"
"            const float *ps = parts + ((size_t)query * heads + head) * splits * 256;\n"
"            float maximum = shared_meta[q][0].x;\n"
"            for (int i = 1; i < splits; ++i) maximum = fmaxf(maximum, shared_meta[q][i].x);\n"
"            float numerator = 0.0f, denominator = 0.0f;\n"
"            for (int i = 0; i < splits; ++i) {\n"
"                float scale = expf(shared_meta[q][i].x - maximum);\n"
"                numerator += scale * ps[(size_t)i * 256 + tid];\n"
"                denominator += scale * shared_meta[q][i].y;\n"
"            }\n"
"            value = numerator / denominator;\n"
"        } else value = 0.0f;\n"
"        if (query < queries) {\n"
"            float g = gate[((size_t)query * heads + head) * 256 + tid];\n"
"            out[((size_t)query * heads + head) * 256 + tid] =\n"
"                value * (1.0f / (1.0f + __expf(-g)));\n"
"        }\n"
"    }\n"
"}\n"
