static const char qwen35_attention_q8_gate_source[] =
"__device__ __forceinline__ int q8_gate_splits(int length, int heads, int nsm, int occupancy) {\n"
"    int tiles = (length + 255) / 256;\n"
"    if (length >= 16384) {\n"
"        int splits = (length + 511) / 512;\n"
"        if (length >= 65536 && length < 98304)\n"
"            splits = min(splits, 64);\n"
"        return min(128, max(occupancy, splits));\n"
"    }\n"
"    int result = min(occupancy, tiles), best = 0, waves_best = 0;\n"
"    int blocks_per_wave = nsm * occupancy;\n"
"    for (int trial = result; trial <= tiles; ++trial) {\n"
"        int blocks = heads * trial;\n"
"        int waves = (blocks + blocks_per_wave - 1) / blocks_per_wave;\n"
"        int efficiency = 100 * blocks / (waves * blocks_per_wave);\n"
"        if (best >= 95 && waves > waves_best) break;\n"
"        if (efficiency > best) { best = efficiency; waves_best = waves; result = trial; }\n"
"    }\n"
"    return result;\n"
"}\n"
"extern \"C\" __global__ __launch_bounds__(256, 1)\n"
"void qwen35_attention_q8_combine_gate(float *out, const float *parts,\n"
"        const float2 *meta, const float *gate, const int *position,\n"
"        int heads, int nsm, int occupancy, int forced_splits) {\n"
"    int query = blockIdx.y, tid = threadIdx.x;\n"
"    int splits = forced_splits ? forced_splits :\n"
"        q8_gate_splits(position[query] + 1, heads, nsm, occupancy);\n"
"    int head = query * heads + blockIdx.x;\n"
"    float value;\n"
"    if (splits == 1) {\n"
"        value = out[head * 256 + tid];\n"
"    } else {\n"
"        parts += head * splits * 256; meta += head * splits;\n"
"        extern __shared__ float2 shared_meta[];\n"
"        for (int i = tid; i < 2 * splits; i += 256)\n"
"            ((float *)shared_meta)[i] = ((const float *)meta)[i];\n"
"        __syncthreads();\n"
"        float maximum = shared_meta[0].x;\n"
"        for (int i = 1; i < splits; ++i) maximum = fmaxf(maximum, shared_meta[i].x);\n"
"        float numerator = 0.0f, denominator = 0.0f;\n"
"        for (int i = 0; i < splits; ++i) {\n"
"            float scale = expf(shared_meta[i].x - maximum);\n"
"            numerator += scale * parts[i * 256 + tid];\n"
"            denominator += scale * shared_meta[i].y;\n"
"        }\n"
"        value = numerator / denominator;\n"
"    }\n"
"    float g = gate[head * 256 + tid];\n"
"    /* This module is compiled with precise math so split-combine retains\n"
"     * the native Q8 attention contract.  The standalone sigmoid kernel is\n"
"     * compiled with fast math, whose expf maps to the native intrinsic. */\n"
"    out[head * 256 + tid] = value * (1.0f / (1.0f + __expf(-g)));\n"
"}\n"
"extern \"C\" __global__ __launch_bounds__(256, 1)\n"
"void qwen35_attention_q8_combine_verify4_gate(float *out, const float *parts,\n"
"        const float2 *meta, const float *gate, const int *position,\n"
"        int heads, int nsm, int occupancy, int forced_splits, int queries) {\n"
"    int head = blockIdx.x, q0 = blockIdx.y * 4, tid = threadIdx.x;\n"
"    __shared__ float2 shared_meta[4][128];\n"
"    __shared__ int split_count[4];\n"
"    if (tid < 4) {\n"
"        int query = q0 + tid;\n"
"        split_count[tid] = query < queries ? (forced_splits ? forced_splits :\n"
"            q8_gate_splits(position[query] + 1, heads, nsm, occupancy)) : 0;\n"
"    }\n"
"    __syncthreads();\n"
"    for (int q = 0; q < 4; ++q) {\n"
"        int splits = split_count[q];\n"
"        if (splits > 1) {\n"
"            int query = q0 + q;\n"
"            const float2 *ms = meta + ((size_t)query * heads + head) * splits;\n"
"            for (int i = tid; i < splits; i += 256) shared_meta[q][i] = ms[i];\n"
"        }\n"
"    }\n"
"    /* The four metadata rows are independent. Load them all before one\n"
