  "build_script": "#!/bin/bash\nset -euo pipefail\nroot=$HOME/work/gemm/glm53f-strata-20261001\ncd \"$root/a64fx/glm5\"\nwork=$root/tmp/strata-mla-logits-20261003\nold=$root/tmp/strata-pipeline-20261002/build\nbase=$root/tmp/strata-mhc-sync-20261002/build-integrated-login-v4\nbin=$PWD/build/candidate-mla-logits-v3\nmkdir -p \"$bin\"\nexport TMPDIR=$work OPAL_PREFIX=/opt/FJSVxtclanga/tcsds-1.2.43\nunset OMPI_CC OMPI_CXX\ncc=/opt/FJSVxtclanga/tcsds-1.2.43/bin/mpifccpx\nflags=(-Nclang -O3 -march=armv8.2-a+sve -ffp-contract=fast -fopenmp -Wall -Wextra -Werror -ffast-math -fno-math-errno -DGLM53F_PREFILL_ATTN_PANEL=47 -DGLM53F_PREFILL_CAPACITY=4096 -I. -I../../common)\n\"$cc\" \"${flags[@]}\" test_glm53f_mla_logits_team.c -lm -o \"$bin/test_glm53f_mla_logits_team\"\n\"$cc\" -Nclang -O3 -march=armv8.2-a+sve -ffp-contract=fast -fopenmp -Wall -Wextra -Werror -I. -I../../common test_glm53f_mla_logits_team.c -lm -o \"$bin/test_glm53f_mla_logits_team-conservative\"\n\"$cc\" \"${flags[@]}\" -DGLM53F_EXTERNAL_ST_IMPLEMENTATION -DGLM53F_SPARSE_NO_MAIN -c glm53f_sparse_layer_12n.c -o \"$work/sparse_logits_v3.o\"\nobjects=(\"$base\"/{q8_panel,gemm_kern,gemm_asm,team,collective}.o \"$root/tmp/strata-iq-scales-20261002/build-integrated-v5/iq_bridge.o\" \"$old/kda_pp_beta_rowwise.o\" \"$root/tmp/strata-pipeline-20261003/dense_tiles_full.o\" \"$old/moe_pp_fast.o\" \"$work/sparse_logits_v3.o\" \"$root/tmp/strata-mtp-batch-20261003/head_verify.o\" \"$root/tmp/strata-mtp-batch-20261003/embedding_prime.o\" \"$old\"/{dist,pipeline}_pp.o)\nlink=(-L\"$root/tmp/strata-mhc-sync-20261002/target-libs\" -lm -lpthread -ltofucom)\n\"$cc\" \"${flags[@]}\" bench_glm53f_run_12n.c \"$base\"/{lookup_spec,mtp_spec}.o \"$root/tmp/strata-mtp-batch-20261003/mtp_prime.o\" \"${objects[@]}\" \"$root/tmp/strata-pipeline-20261003/target_dense_tiles.o\" \"${link[@]}\" -o \"$bin/bench_glm53f_run_12n\"\ncp \"$root/a64fx/glm5/build/candidate-dense-tile-v2/tofu_topo_helper\" \"$bin/tofu_topo_helper\"\nsha256sum \"$bin\"/{test_glm53f_mla_logits_team,bench_glm53f_run_12n} > \"$work/binaries-v3.sha256\"\necho MLA_TILES_BUILD_PASS\n",
  "native_driver": "#!/bin/bash\nset -euo pipefail\ncd \"$HOME/work/gemm/glm53f-strata-20261001\"\nlogs=$PWD/tmp/strata-mla-logits-20261003\n[ \"${PJM_JOBID:-}\" = 52138572 ] && [ \"$PJM_NODE\" = 12 ]\nguard=$(date -d '2026-10-04 04:45:00 JST' +%s)\nexport GLM53F_BUILD=0 GLM53F_GGUF=$HOME/models/glm53f-gguf-wide/UD-Q4_K_XL/GLM-5.3-Flash-UD-Q4_K_XL-00001-of-00006.gguf\nexport GLM53F_BIN_DIR=$PWD/a64fx/glm5/build/candidate-mla-logits-v2 GLM53F_RUN_TAG=mtp-batch3-gates\nexport XOS_MMM_L_PAGING_POLICY=demand:demand:demand XOS_MMM_L_HPAGE_TYPE=none\nexport OMP_NUM_THREADS=47 OMP_PROC_BIND=close OMP_PLACES=cores OMP_WAIT_POLICY=active FLIB_BARRIER=HARD\nexport GLM53F_PREWARM=1 GLM53F_PROFILE=1 GLM53F_FAST_MATH=1 GLM53F_NO_MATH_ERRNO=1\nexport GLM53F_COMM_OWNER=0 GLM53F_SPARSE_ASYNC=0 GLM53F_NATIVE_Q8_PANEL=0 GLM53F_SPARSE_MLA_BATCH=1\nexport GLM53F_NATIVE_Q8_ROWS8=0 GLM53F_NATIVE_Q8_TILE2X8=0 GLM53F_MLA_FUSED_PROJECTION=0 GLM53F_MHC_FUSED_SYNC=0 GLM53F_MOE_GU_PAD=0\nexport GLM53F_EMBED_BATCH_PACKED=0 GLM53F_HEAD_VERIFY_SHARED=0 GLM53F_DENSE_PREFILL_TILE=4\nfail(){ echo \"error: $*\" >&2; exit 2; }\nsource a64fx/glm5/scripts/glm53f_env.sh\nsource a64fx/glm5/scripts/glm53f_launch.sh\nmkdir -p \"$logdir\" \"$GLM53F_BUILD_DIR\" \"$logs/results\"\n# This synthetic MPI fixture has no model staging or tofu dependency.\nfor math in fast conservative; do\n binary=\"$GLM53F_BIN_DIR/test_glm53f_mla_logits_team\"\n [ \"$math\" = fast ] || binary=\"$binary-conservative\"\n for threads in 1 47; do\n  OMP_NUM_THREADS=$threads mpi_run \"mla-logits-$math-$threads\" /usr/bin/numactl --interleave=4,5,6,7 \"$binary\"\n  grep '^MLA_LOGITS_TEAM .*BIT_EXACT PASS$' \"$last_log\".*.0\n  cp \"$last_log\".*.0 \"$logs/results/logits-$math-$threads.log\"\n done\ndone\necho MLA_LOGITS_NATIVE_PASS\n",
